        "custom_liquid": "{%- comment -%}\n  AU / NZ: country-correct shipping copy + currency code next to every price.\n{%- endcomment -%}\n{%- assign ms_cc = localization.country.iso_code -%}\n{%- if ms_cc == 'AU' or ms_cc == 'NZ' -%}\n{%- if ms_cc == 'AU' -%}{%- assign ms_name = 'Australia' -%}{%- else -%}{%- assign ms_name = 'New Zealand' -%}{%- endif -%}\n<script>\n(function () {\n  var N = {{ ms_name | json }};\n  var CUR = {{ localization.country.currency.iso_code | json }};\n  var RULES = [\n    [/anywhere in the United States/g, 'anywhere in ' + N],\n    [/Free shipping in the US\\./g, 'Free shipping to ' + N + '.'],\n    [/US delivery usually takes about 6[–-]10 business days after shipping/g, 'Delivery to ' + N + ' usually takes about 6–10 business days after shipping'],\n    [/ships within 2[–-]3 days/g, 'ships within 1–3 working days'],\n    [/in 5[–-]10 business days anywhere\\./g, 'in 6–10 business days anywhere in ' + N + '.'],\n    [/Ships Within 2-4 Working Days/g, 'Ships Within 1-3 Working Days']\n  ];\n  var PRICE = /(\\$\\s?\\d[\\d,]*(?:\\.\\d{2})?)(?![\\d.,]*\\s?(?:[A-Z]{3}\\b))/g;\n\n  function fixNode(n) {\n    var v = n.nodeValue, o = v;\n    for (var i = 0; i < RULES.length; i++) v = v.replace(RULES[i][0], RULES[i][1]);\n    v = v.replace(PRICE, '$1 ' + CUR);\n    if (v !== o) n.nodeValue = v;\n  }\n  function fix(root) {\n    if (!root) return;\n    if (root.nodeType === 3) { fixNode(root); return; }\n    if (root.nodeType !== 1 || /^(SCRIPT|STYLE|TEXTAREA|INPUT|NOSCRIPT)$/.test(root.tagName)) return;\n    var w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null), n;\n    while ((n = w.nextNode())) {\n      var p = n.parentNode && n.parentNode.tagName;\n      if (p && /^(SCRIPT|STYLE|TEXTAREA|NOSCRIPT)$/.test(p)) continue;\n      fixNode(n);\n    }\n  }\n  function start() {\n    fix(document.body);\n    new MutationObserver(function (list) {\n      list.forEach(function (m) {\n        if (m.type === 'characterData') fixNode(m.target);\n        else m.addedNodes.forEach(fix);\n      });\n    }).observe(document.body, { childList: true, subtree: true, characterData: true });\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);\n  else start();\n})();\n</script>\n{%- endif -%}",
