<figure><svg viewBox="0 0 86 86" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="43" cy="43" r="41.5"/><circle cx="43" cy="43" r="9" opacity=".6"/></svg><figcaption><b>6 in</b>Pro (L)</figcaption></figure>
<figure><svg viewBox="0 0 142 142" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><circle cx="71" cy="71" r="69.5"/><circle cx="71" cy="71" r="15" opacity=".6"/></svg><figcaption><b>10 in</b>Plus (XL)</figcaption></figure>
