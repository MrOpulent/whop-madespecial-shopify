  © BlockyApps. You are permitted to use this content within your store. Redistribution or use in any other application is strictly prohibited. 
  Unauthorized copying, distribution, or reproduction in any form will result in legal action.
{% endcomment %}
{% style %}
  .blocky-image-with-text .blocky-flex-layout-2 img,
  .blocky-image-with-text .blocky-flex-layout-2 svg {
    border-radius: 0px;
  }
  #blocky-image-with-text-{{ section.id }} .blocky-flex-container.blocky-flex-layout-2 {
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    {% if section.settings.show_border == true %}border: 1px solid {{ section.settings.border_color }};{% endif %}
  }
  #blocky-image-with-text-{{ section.id }} .blocky-image-with-text-placeholder,
  #blocky-image-with-text-{{ section.id }} .blocky-media {
    {% if section.settings.layout_style != "2" %}
      border-radius: {{ section.settings.border_radius }}px;
      {% if section.settings.show_border == true %}border: 1px solid {{ section.settings.border_color }};{% endif %}
    {% endif %}
  }
{% endstyle %}
<div 
  id="blocky-image-with-text-{{ section.id }}"
  class="blocky blocky-image-with-text blocky-padding background-wrapper"
  style="--padding-top: {{ section.settings.padding_top }}; --padding-bottom: {{ section.settings.padding_bottom }}; --background-color: {{ section.settings.background_color }}; --section-page-width: {{ section.settings.page_width | divided_by: 10 }}rem; --text-container-gap: {{ section.settings.text_container_gap }}; --layout-2-background-color:{{ section.settings.layout_2_background_color }};"
>
  <div class="blocky-page-width">
    {%- comment -%} MS: XL/XXL "What's in the box" boxes. Content = product metafield custom.whats_in_box (list of Box item metaobjects: title, image). Turn on with the section setting "Show XL/XXL box grid". {%- endcomment -%}
    {%- if section.settings.ms_box_enable and product -%}
      {%- assign ms_items = product.metafields.custom.whats_in_box.value -%}
      <style>
        #ms-wib-{{ section.id }}{display:none;width:100%}
        #ms-wib-{{ section.id }}.is-on{display:block}
        .ms-wib-on > .blocky-flex-container{display:none !important}
        #ms-wib-{{ section.id }} .ms-wib__grid{display:grid;grid-template-columns:repeat({{ section.settings.ms_box_cols }},1fr);gap:16px}
        #ms-wib-{{ section.id }} .ms-wib__card{background:#f6f8fa;border-radius:14px;padding:20px 14px 18px;text-align:center;display:flex;flex-direction:column;align-items:center}
        #ms-wib-{{ section.id }} .ms-wib__title{font-size:17px;line-height:1.3;margin:0 0 14px;color:#1a1a1a;font-weight:500}
        #ms-wib-{{ section.id }} .ms-wib__media{position:relative;width:100%;max-width:220px;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center}
        #ms-wib-{{ section.id }} .ms-wib__media::before{content:"";position:absolute;inset:8%;border-radius:46% 54% 50% 50%/55% 45% 55% 45%;background:transparent;}
        #ms-wib-{{ section.id }} .ms-wib__card:nth-child(4n+2) .ms-wib__media,#ms-wib-{{ section.id }} .ms-wib__card:nth-child(4n+3) .ms-wib__media{--blob:#fbf1ea}
        #ms-wib-{{ section.id }} .ms-wib__media svg{position:relative;width:80%;height:80%;opacity:.5}
        #ms-wib-{{ section.id }} .ms-wib__media img{position:relative;max-width:88%;max-height:88%;height:auto;object-fit:contain}
        @media (max-width:749px){#ms-wib-{{ section.id }} .ms-wib__grid{grid-template-columns:1fr 1fr;gap:10px}#ms-wib-{{ section.id }} .ms-wib__card{padding:14px 8px}#ms-wib-{{ section.id }} .ms-wib__title{font-size:14px;margin-bottom:8px}}
      </style>
      
      <div class="ms-wib" id="ms-wib-{{ section.id }}" data-trigger="{{ section.settings.ms_box_trigger | default: 'XL' | escape }}">
        <div class="ms-wib__grid">
          {%- if ms_items.size > 0 -%}
            {%- for item in ms_items -%}
              <div class="ms-wib__card"><p class="ms-wib__title">{{ item.title.value }}</p><div class="ms-wib__media">{%- if item.image.value != blank -%}{{ item.image.value | image_url: width: 600 | image_tag: loading: 'lazy', alt: item.title.value }}{%- endif -%}</div></div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
            {%- if block.type == 'ms_box_item' -%}
              <div class="ms-wib__card" {{ block.shopify_attributes }}><p class="ms-wib__title">{{ block.settings.title }}</p><div class="ms-wib__media">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</div></div>{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
      <script>
        (function(){
          var g=document.getElementById('ms-wib-{{ section.id }}'); if(!g) return;
          var wrap=g.parentNode, word=g.getAttribute('data-trigger')||'XL';
          function picked(){
            var s=document.querySelectorAll('select.kaching-bundles__bar-variant-select');
            for(var i=0;i<s.length;i++){ if(!s[i].offsetParent) continue; var o=s[i].options[s[i].selectedIndex]; if(o && o.text.indexOf(word)!==-1) return true; }
            return false;
          }
          function update(){ var on=picked(); g.classList.toggle('is-on',on); wrap.classList.toggle('ms-wib-on',on); }
          document.addEventListener('change',function(){setTimeout(update,50)},true);
          document.addEventListener('click',function(){setTimeout(update,150)},true);
          setInterval(update,800); update();
        })();
      </script>
      {%- comment -%} MS: switch the main product image to the picked size/colour (falls back to that size's first photo) {%- endcomment -%}
      <script>
        (function(){
          var data=null;
          fetch('/products/{{ product.handle }}.js').then(function(r){return r.json();}).then(function(d){data=d;});
          function show(id){
            if(!id) return;
            var b=document.querySelectorAll('button[data-blocky-product-thumb="'+id+'"]'), t=null;
            for(var i=0;i<b.length;i++){ if(!b[i].closest('.glide__slide--clone')){ t=b[i]; break; } }
            t=t||b[0];
            if(t && !t.classList.contains('is-active')) t.click();
          }
          function pick(row){
            if(!data || !row) return;
            var s=row.querySelectorAll('select.kaching-bundles__bar-variant-select'); if(s.length<2) return;
            var c=s[0].options[s[0].selectedIndex].text, z=s[1].options[s[1].selectedIndex].text, v=null, f=null;
            data.variants.forEach(function(x){ if(x.option2===z){ if(x.option1===c) v=x; if(!f && x.featured_media) f=x; } });
            var m=(v && v.featured_media) || (f && f.featured_media);
            if(m) show(m.id);
          }
          document.addEventListener('change',function(e){
            var t=e.target;
            if(t.matches && t.matches('select.kaching-bundles__bar-variant-select')) setTimeout(function(){ pick(t.closest('.kaching-bundles__bar-variant-selects')); },100);
          },true);
        })();
      </script>
    {%- endif -%}    
    <div class="blocky-flex-container blocky-mob-flex-{{ section.settings.mobile_layout }} blocky-des-flex-{{ section.settings.layout }} blocky-flex-layout-{{ section.settings.layout_style }}{% if section.settings.shadow == true and section.settings.layout_style == "2" %} blocky-shadow{% endif %}">
      <div class="blocky-flex-child blocky-flex-child-{{ section.settings.desktop_image_width }} blocky-justify-center blocky-media-{{ section.settings.height }}">
        {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
          <video
            class="blocky-media blocky-image-{{ section.settings.image_fit }}{% if section.settings.shadow and section.settings.layout_style != "2" %} blocky-shadow{% endif %}"
            autoplay muted loop playsinline disablepictureinpicture disableremoteplayback preload="metadata" aria-hidden="true"
            {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: height: 750 }}"{% elsif section.settings.video.preview_image %}poster="{{ section.settings.video.preview_image | image_url: height: 750 }}"{% endif %}
            style="pointer-events:none;width:100%;height:100%;display:block"
          >
            {%- for source in section.settings.video.sources -%}{%- if source.format == 'mp4' or source.mime_type contains 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}{%- endfor -%}
            {%- for source in section.settings.video.sources -%}{%- unless source.format == 'mp4' or source.mime_type contains 'mp4' or source.format == 'm3u8' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endunless -%}{%- endfor -%}
          </video>
        {%- elsif section.settings.image != blank -%}
          <img
            class="blocky-media blocky-image-{{ section.settings.image_fit }}{% if section.settings.shadow and section.settings.layout_style != "2" %} blocky-shadow{% endif %}"
            src="{{ section.settings.image | image_url: height: 750 }}"
          >  
        {% else %}
          {% capture placeholder_class %}blocky-media blocky-image-with-text-placeholder {% if section.settings.shadow %} blocky-shadow{% endif %}{% endcapture %}
          {{ 'image' | placeholder_svg_tag: placeholder_class }}
        {%- endif -%}
      </div>
      <div class="blocky-flex-child blocky-flex-child-2">
        <div class="blocky-media-text-container blocky-align-{{ section.settings.desktop_content_position }} blocky-text-container-desktop-{{ section.settings.desktop_content_alignment }} blocky-text-container-mobile-{{ section.settings.mobile_content_alignment }}">
          {%- for block in section.blocks -%}
            {% case block.type %}
              {%- when 'title' -%}
                {% render 'blocky-titlel', block: block %}
              {%- when 'body' -%}
                {% render 'blocky-bodyl', block: block %}
              {%- when 'button' -%}
                {% render 'blocky-buttonl', block:block %}
              {%- when 'review-stars' -%}
                {% render 'blocky-review-starsl', block:block %}
            {%- endcase -%}
          {%- endfor -%}  
        </div>
      </div>    
    </div>
  </div>
</div>

<script>(function(){function t(){var s=document.querySelector('[id$=__blocky_main_product_7dRCfA]');return (s||document).querySelector('.kaching-bundles, kaching-bundles-block, [class*=kaching-bundles], form[action*=cart]')||s;}function go(e){var el=t();if(!el)return;e.preventDefault();window.scrollTo({top:Math.max(el.getBoundingClientRect().top+window.pageYOffset-90,0),behavior:'smooth'});}function bind(){document.querySelectorAll('[id$=__blocky_image_with_text_fH6kVt] a.blocky-button').forEach(function(b){if(b.dataset.bkyScroll)return;b.dataset.bkyScroll='1';b.setAttribute('href','#buy');b.removeAttribute('aria-disabled');b.removeAttribute('role');b.style.cursor='pointer';b.addEventListener('click',go);});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',bind);}else{bind();}})();</script>

{% schema %}

{
  "name": "BKY - Image & Text",
  "settings": [    { "type": "header", "content": "XL / XXL box grid" },    { "type": "checkbox", "id": "ms_box_enable", "label": "Show XL/XXL box grid", "default": false, "info": "Replaces this section with boxes when the picked size contains the word below. Boxes come from product metafield custom.whats_in_box." },    { "type": "text", "id": "ms_box_trigger", "label": "Show boxes when size contains", "default": "XL" },    { "type": "range", "id": "ms_box_cols", "label": "Boxes per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 4 },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video / GIF (muted, loops, no controls)" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Used when Media type is Video. Plays automatically, muted, on loop, with no controls. For a GIF, convert it to MP4 and upload it here. The image above is shown while the video loads."
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "adapt",
      "label": "Height"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "label": "Desktop image width",
      "info": "Image is automatically optimized for mobile."
    },
    {
      "type": "select",
      "id": "image_fit",
      "options": [
        {
          "value": "contain",
          "label": "Fit"
        },
        {
          "value": "cover",
          "label": "Zoomed in"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover",
      "label": "Image fit"
    },
    {
      "type": "header",
      "content": "Image Outline"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Show image shadow",
      "default": true,
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_border == true }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },    
    {
      "type": "select",
      "id": "layout_style",
      "options": [
        {
          "value": "1",
          "label": "Style 1"
        },
        {
          "value": "2",
          "label": "Style 2"
        },
      ],
      "default": "1",
      "label": "Layout style",
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "layout_2_background_color",
      "label": "Text background color",
      "default": "#FCFCFC",
      "visible_if": "{{ section.settings.layout_style == '2' }}"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "row",
          "label": "Image first"
        },
        {
          "value": "row-reverse",
          "label": "Text first"
        },
      ],
      "default": "row",
      "label": "Desktop image placement",
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center",
      "label": "Desktop content position"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "options": [
        {
          "value": "col",
          "label": "Image first"
        },
        {
          "value": "col-reverse",
          "label": "Text first"
        }
      ],
      "default": "col",
      "label": "Mobile image placement"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Mobile content alignment"
    },
    {
      "type": "select",
      "id": "text_container_gap",
      "label": "Space between text",
      "default": "1.5rem",
      "options": [
        {
          "label": "None",
          "value": "0"
        },
        {
          "label": "Small",
          "value": "0.5rem"
        },
        {
          "label": "Medium",
          "value": "1rem"
        },
        {
          "label": "Large",
          "value": "1.5rem"
        },
        {
          "label": "Extra Large",
          "value": "2rem"
        },
      ]
    },  

    {
      "type": "header",
      "content": "Section size",
    },
    {
      "type": "range",
      "id": "page_width",
      "unit": "px",
      "step": 100,
      "min": 800,
      "max": 1600,
      "default": 1200,
      "label": "Section width",
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    { "type": "ms_box_item", "name": "XL/XXL box item", "settings": [ { "type": "text", "id": "title", "label": "Item name" }, { "type": "image_picker", "id": "image", "label": "Item image" } ] },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "<b>Image with Text</b>",
          "label": "Title",
          "info": "Leave the text blank to hide the title."
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "default": 60,
          "min": 30,
          "max": 100,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#000000"
        },
      ]
    },
    {
      "type": "body",
      "name": "Body",
      "limit": 4,
      "settings": [
        {
          "type": "richtext",
          "id": "body_text",
          "default": "<p>Showcase your chosen product with a image and text. Add a detailed description to capture the customer's attention</p>",
          "label": "Body",
          "info": "Leave the text blank to hide the body."
        },
        {
          "type": "range",
          "id": "body_size",
          "label": "Body size",
          "default": 16,
          "min": 10,
          "max": 30,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "body_color",
          "label": "Body color",
          "default": "#000000"
        },

      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
