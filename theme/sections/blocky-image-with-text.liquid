  "presets": [
    {
      "name": "Blocky Image and Text",
      "blocks": [
        {
          "type": "review-stars"
        },
        {
          "type": "title"
        },
        {
          "type": "body"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}

{% endschema %}