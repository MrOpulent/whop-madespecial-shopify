{% javascript %}
  (function(){
    var boot=function(){
      var box=document.querySelector('.rs-unbox');
      var v=box&&box.querySelector('.rs-unbox__video');
      var slot=document.getElementById('rs-unbox-slot');
      var homeBefore=document.querySelector('#box .bfs, .rs-one .bfs');
      var mq=window.matchMedia('(min-width: 990px)');
      var place=function(){
        if(!box)return;
        if(mq.matches){
          if(slot&&box.parentNode!==slot)slot.appendChild(box);
        }else if(homeBefore&&homeBefore.parentNode&&box.nextElementSibling!==homeBefore){
          homeBefore.parentNode.insertBefore(box,homeBefore);
        }
      };
      place();
      if(mq.addEventListener)mq.addEventListener('change',place);
      else if(mq.addListener)mq.addListener(place);
      if(v){
        v.muted=true;
        v.defaultMuted=true;
        v.playsInline=true;
        v.setAttribute('playsinline','');
        v.setAttribute('muted','');
        var tryPlay=function(){
          var p=v.play();
          if(p&&p.catch)p.catch(function(){});
        };
        tryPlay();
        if('IntersectionObserver' in window){
          var io=new IntersectionObserver(function(entries){
            entries.forEach(function(e){
              if(e.isIntersecting)tryPlay();
              else v.pause();
            });
          },{rootMargin:'200px 0px',threshold:0.01});
          io.observe(v);
        }
      }
      var mv=document.querySelector('.rs-main-video');
      if(mv){
        mv.muted=true;
        mv.defaultMuted=true;
        mv.playsInline=true;
        mv.setAttribute('playsinline','');
        mv.setAttribute('muted','');
        var tryMain=function(){
          var p=mv.play();
          if(p&&p.catch)p.catch(function(){});
        };
        tryMain();
        if('IntersectionObserver' in window){
          var ioMain=new IntersectionObserver(function(entries){
            entries.forEach(function(e){
              if(e.isIntersecting)tryMain();
              else mv.pause();
            });
          },{rootMargin:'200px 0px',threshold:0.01});
          ioMain.observe(mv);
        }
      }
    };
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);
    else boot();
  })();
{% endjavascript %}
