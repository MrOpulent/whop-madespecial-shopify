    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#e8301f"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_fold",
      "label": "Badge fold color",
      "default": "#9e1a0e"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge text size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#f6f8fb"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Card title color",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subheading / description color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New item"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "show_badge",
          "label": "Show badge on this card",
          "default": false
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (optional override)",
          "info": "Leave empty to use the default badge text from the section settings."
        },
        {
          "type": "checkbox",
          "id": "show_blob",
          "label": "Show soft shape behind image",
          "info": "Turn off if your image already has a background shape baked in.",
          "default": false
        },
        {
          "type": "color",
          "id": "blob_color",
          "label": "Shape color",
          "default": "#e6f2ec"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What You Get",
      "blocks": [
        { "type": "item", "settings": { "title": "Rain Drum (XL / XXL)", "blob_color": "#e6f2ec", "show_badge": false } },
