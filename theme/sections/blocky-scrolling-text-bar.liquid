{% style %}
#shopify-section-{{ section.id }}:has(> .blocky-announcement-bar.blocky-announcement-bar-sticky) {
  position: sticky;
  top: calc({{ section.settings.sticky_offset }}px - 1px);
  z-index: 10;
  overflow: visible !important;
}
#shopify-section-{{ section.id }} .blocky-announcement-bar {
  --text-color: {{ section.settings.text_color }};
  --text-size: {{ section.settings.text_size }};
  --text-spacing: {{ section.settings.text_spacing }};
  --marquee-speed: {{ section.settings.speed }};
  --icon-size: {{ section.settings.icon_size }}px;
  --icon-color: {{ section.settings.icon_color }};
}
{% endstyle %}

{% stylesheet %}
.blocky-announcement-bar {
  position: relative;
  width: 100%;
  z-index: 1;
  padding-top: calc(var(--padding-top) * 1px);
  padding-bottom: calc(var(--padding-bottom) * 1px);
  box-sizing: border-box;
  background-color: var(--background-color);
  max-width: var(--section-page-width);
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
}
.blocky-announcement-bar-inner {
  display: block;
  padding: 0;
}
.blocky-announcement-bar-link {
  display: block;
  text-decoration: none;
  color: inherit;
}
.blocky-announcement-bar-text {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.blocky-scrolling-text-bar-icon,
.blocky-scrolling-text-bar-icon-code {
  flex-shrink: 0;
}
.blocky-scrolling-text-bar-icon {
  width: var(--icon-size);
  height: var(--icon-size);
  object-fit: contain;
}
.blocky-scrolling-text-bar-icon-code {
  font-size: var(--icon-size);
  color: var(--icon-color);
  line-height: 1;
}
{% endstylesheet %}

{% capture scrolling_text_bar_content %}
{%- assign bky_special_handles = section.settings.special_handles | split: ',' -%}
  {%- assign bky_is_special = false -%}
  {%- if product and bky_special_handles contains product.handle -%}{%- assign bky_is_special = true -%}{%- endif -%}
  {%- capture bky_visible -%}
    {%- for block in section.blocks -%}
      {%- case block.settings.show_on -%}
        {%- when 'special' -%}{%- if bky_is_special -%}x{%- endif -%}
        {%- when 'others' -%}{%- unless bky_is_special -%}x{%- endunless -%}
        {%- else -%}x
      {%- endcase -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign blockCount = bky_visible | size -%}
  {%- if blockCount == 0 -%}{%- assign blockCount = 1 -%}{%- endif -%}
  {%- assign upperLimit = 20 | divided_by: blockCount | ceil %}

  {% capture marqueeContainer %}
    <div class="blocky-announcement-bar-container" style="display: flex; flex-shrink:0;">
      {% for i in (1..upperLimit) %}
 {%- for block in section.blocks -%}
            {%- if block.settings.show_on == 'special' and bky_is_special == false -%}{%- continue -%}{%- endif -%}
            {%- if block.settings.show_on == 'others' and bky_is_special -%}{%- continue -%}{%- endif -%}
            {%- capture icon_markup -%}
              {%- if block.settings.icon_choice == 'image' and block.settings.image != blank -%}
                <img class="blocky-scrolling-text-bar-icon" src="{{ block.settings.image | image_url: width: 200 }}" alt="" loading="lazy">
              {%- elsif block.settings.icon_choice == 'icon' and block.settings.icon_code != blank -%}
                <span class="material-icons material-symbols-outlined blocky-scrolling-text-bar-icon-code">{{ block.settings.icon_code }}</span>
              {%- endif -%}
            {%- endcapture -%}
            <p
              class="blocky-announcement-bar-text"
              {{ block.shopify_attributes }}
            >
              {%- if section.settings.icon_position == 'before' -%}{{ icon_markup }}{%- endif -%}
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
              {%- if section.settings.icon_position == 'after' -%}{{ icon_markup }}{%- endif -%}
            </p>
          {%- endfor -%}
      {% endfor %}
    </div>
  {% endcapture %}

  <div style="display: flex;">
    {{ marqueeContainer }}
    {{ marqueeContainer }}
    {{ marqueeContainer }}
  </div>
{% endcapture %}
{%- if bky_visible != blank -%}
{% render 'blocky-announcement-bar-shell', content: scrolling_text_bar_content, background_color: section.settings.background_color, padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom, page_width: 1200, full_width: true, link: section.settings.cta_link, sticky: section.settings.sticky %}
{%- endif -%}
{% schema %}
{
  "name": "BKY - Scrolling Text Bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick to top of page",
      "default": false
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "Sticky top offset",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "If your theme has its own sticky header, set this to its height so the two don't overlap.",
      "visible_if": "{{ section.settings.sticky == true }}"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "1.25",
          "label": "Extra small"
        },
        {
          "value": "1.5",
          "label": "Small"
        },
        {
          "value": "1.75",
          "label": "Medium"
        },
        {
          "value": "2",
          "label": "Large"
        },
        {
          "value": "2.5",
          "label": "Extra large"
        }
      ],
      "default": "1.75"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Ticker speed",
      "min": 0,
      "max": 5,
      "default": 1,
      "step": 0.5
    },
    {
      "type": "range",
      "id": "text_spacing",
      "label": "Text spacing",
      "min": 1,
      "max": 5,
      "default": 3,
      "step": 0.5
    },
    {
      "type": "header",
      "content": "Icon / Image"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Position",
      "options": [
        {
          "value": "before",
          "label": "Before text"
        },
        {
          "value": "after",
          "label": "After text"
        }
      ],
      "default": "before"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon / image size",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Block Padding",
      "info": "Change the size of the announcement bar"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "url",
      "id": "cta_link",
"label": "Link",
      "info": "Optional. When set, clicking anywhere on the bar navigates here."
    },
    {
      "type": "header",
      "content": "Page targeting"
    },
    {
      "type": "text",
      "id": "special_handles",
      "label": "Special product pages (handles)",
      "default": "maria-hand-tuned-rain-drum",
      "info": "Comma-separated product handles, no spaces. Used by each text item's 'Show on' setting."
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
"default": "Scrolling Text Bar",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "show_on",
          "label": "Show on",
          "options": [
            { "value": "all", "label": "All pages" },
            { "value": "special", "label": "Special pages only (Maria)" },
            { "value": "others", "label": "All pages except special pages" }
          ],
          "default": "all"
        },
        {
          "type": "header",
          "content": "Icon / Image"
        },
        {
          "type": "select",
          "id": "icon_choice",
          "label": "Icon or image",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "icon",
              "label": "Icon"
            },
            {
              "value": "image",
              "label": "Image"
            }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.icon_choice == 'image' }}"
        },
        {
          "type": "text",
          "id": "icon_code",
          "label": "Icon code",
          "default": "star",
          "info": "Get icon codes from [this link](https://fonts.google.com/icons/). example: 'check_circle', 'search', 'home'. For help adding icons, you can click [here](/admin/apps/blocky-apps/icons)",
          "visible_if": "{{ block.settings.icon_choice == 'icon' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blocky Scrolling Text Bar",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "text"
        },
        {
          "type": "text"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}