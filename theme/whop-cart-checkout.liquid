{%- comment -%}
  Essential Cart drawer / cart page "Checkout" -> your branded checkout page (checkout.madespecial.store),
  where the buyer enters contact + delivery details and pays with Whop's secure payment form.
  Kaching + Essential discounts stay as they are; the server re-prices the cart with Shopify.
  Paste in theme.liquid just before </body>. Set ENDPOINT to https://<your checkout domain>/api/checkout-session.
{%- endcomment -%}
<div id="wh-load" role="status" aria-live="polite" hidden>
  <div class="wh-box">
    <div class="wh-spin" aria-hidden="true"></div>
    <p id="wh-msg">Taking you to secure checkout…</p>
    <button type="button" id="wh-close" hidden>Close</button>
  </div>
</div>
<style>
  #wh-load{position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px}
  #wh-load[hidden]{display:none}
  #wh-load .wh-box{background:#fff;color:#1a1a1a;border-radius:14px;padding:24px 22px;max-width:360px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.25);font:15px/1.45 inherit}
  #wh-load .wh-spin{width:34px;height:34px;margin:0 auto 12px;border:3px solid #e3e3e3;border-top-color:#1a1a1a;border-radius:50%;animation:whspin .8s linear infinite}
  #wh-load.err .wh-spin{display:none}
  #wh-load.err #wh-msg{color:#c0262d}
  #wh-load p{margin:0}
  #wh-close{margin-top:14px;padding:10px 18px;border:0;border-radius:8px;background:#1a1a1a;color:#fff;font:inherit;cursor:pointer}
  @keyframes whspin{to{transform:rotate(360deg)}}
</style>
<script>
(function () {
  var ENDPOINT = 'https://checkout.madespecial.store/api/checkout-session';
  // Essential Cart drawer checkout button + theme cart page. Add the drawer button's class if it isn't caught.
  var SEL = '[name="checkout"], a[href^="/checkout"], a[href*="/checkout?"], button[onclick*="checkout"], .es-checkout-button';
  var SHOPPER_COUNTRY = {{ localization.country.iso_code | default: 'US' | json }};

  // RedTrack / ad tracking: click IDs, UTMs and ad-platform IDs from cookies, storage and the page URL.
  // They are written onto the Shopify order (with the cart attributes) so RedTrack can attribute the sale.
  var TRACK = /clickid|ref_?id|rtk|^utm_|fbclid|gclid|gbraid|wbraid|ttclid|msclkid|^_fbp$|^_fbc$|^_ga$/i;
  function trackingData() {
    var t = {};
    function put(k, v) { if (k && v && TRACK.test(k) && String(v).length <= 300) t[k] = String(v); }
    try { document.cookie.split(';').forEach(function (c) { var i = c.indexOf('='); if (i > 0) put(decodeURIComponent(c.slice(0, i).trim()), decodeURIComponent(c.slice(i + 1).trim())); }); } catch (e) {}
    try { for (var i = 0; i < localStorage.length; i++) { var k = localStorage.key(i); put(k, localStorage.getItem(k)); } } catch (e) {}
    try { new URLSearchParams(location.search).forEach(function (v, k) { put(k, v); }); } catch (e) {}
    return t;
  }

  var box = document.getElementById('wh-load'), msg = document.getElementById('wh-msg'), closeBtn = document.getElementById('wh-close'), busy = false;
  var MSG = {
    price_mismatch: 'Your cart was just updated. Please check your cart and try again.',
    empty_cart: 'Your cart is empty.',
    cart_invalid: 'An item in your cart is no longer available. Please update your cart.'
  };
  function show(text, isErr) { msg.textContent = text; box.classList.toggle('err', !!isErr); closeBtn.hidden = !isErr; box.hidden = false; }
  closeBtn.onclick = function () { box.hidden = true; };
  window.addEventListener('pageshow', function () { busy = false; box.hidden = true; }); // back button from Whop

  document.addEventListener('click', async function (e) {
    if (!e.target.closest(SEL)) return;
    e.preventDefault(); e.stopImmediatePropagation();
    if (busy) return; busy = true;
    show('Taking you to secure checkout…');
    try {
      var cart = await (await fetch('/cart.js', { cache: 'no-store' })).json();
      if (!cart.item_count) throw { code: 'empty_cart' };
      var r = await fetch(ENDPOINT, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: cart.items.map(function (i) { return { variant_id: i.variant_id, quantity: i.quantity, properties: i.properties || {} }; }),
          attributes: cart.attributes || {},
          total_price: cart.total_price,
          currency: cart.currency,
          market_country: (window.Shopify && Shopify.country) || SHOPPER_COUNTRY, // the Shopify Market whose currency the drawer shows
          tracking: trackingData()
        })
      });
      var d = await r.json();
      if (!d.url) throw { code: d.error };
      window.location.href = d.url;
    } catch (err) {
      console.error('Whop checkout', err);
      show(MSG[err && err.code] || 'Checkout is unavailable right now. Please try again in a moment.', true);
      busy = false;
    }
  }, true);
})();
</script>
