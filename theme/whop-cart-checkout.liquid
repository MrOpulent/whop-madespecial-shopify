000/svg\" role=\"img\" viewBox=\"0 0 38 24\" width=\"57\" height=\"36\" aria-hidden=\"true\"><path d=\"M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z\" fill=\"#000\" opacity=\".07\"/><path d=\"M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32\" fill=\"#FFF\"/><path d=\"M18.093 11.976v3.2h-1.018v-7.9h2.691a2.447 2.447 0 0 1 1.747.692 2.28 2.28 0 0 1 .11 3.224l-.11.116c-.47.447-1.098.69-1.747.674l-1.673-.006zm0-3.732v2.788h1.698c.377.012.741-.135 1.005-.404a1.391 1.391 0 0 0-1.005-2.354l-1.698-.03zm6.484 1.348c.65-.03 1.286.188 1.778.613.445.43.682 1.03.65 1.649v3.334h-.969v-.766h-.049a1.93 1.93 0 0 1-1.673.931 2.17 2.17 0 0 1-1.496-.533 1.667 1.667 0 0 1-.613-1.324 1.606 1.606 0 0 1 .613-1.336 2.746 2.746 0 0 1 1.698-.515c.517-.02 1.03.093 1.49.331v-.208a1.134 1.134 0 0 0-.417-.901 1.416 1.416 0 0 0-.98-.368 1.545 1.545 0 0 0-1.319.717l-.895-.564a2.488 2.488 0 0 1 2.182-1.06zM23.29 13.52a.79.79 0 0 0 .337.662c.223.176.5.269.785.263.429-.001.84-.17 1.146-.472.305-.286.478-.685.478-1.103a2.047 2.047 0 0 0-1.324-.374 1.716 1.716 0 0 0-1.03.294.883.883 0 0 0-.392.73zm9.286-3.75l-3.39 7.79h-1.048l1.281-2.728-2.224-5.062h1.103l1.612 3.885 1.569-3.885h1.097z\" fill=\"#5F6368\"/><path d=\"M13.986 11.284c0-.308-.024-.616-.073-.92h-4.29v1.747h2.451a2.096 2.096 0 0 1-.9 1.373v1.134h1.464a4.433 4.433 0 0 0 1.348-3.334z\" fill=\"#4285F4\"/><path d=\"M9.629 15.721a4.352 4.352 0 0 0 3.01-1.097l-1.466-1.14a2.752 2.752 0 0 1-4.094-1.44H5.577v1.17a4.53 4.53 0 0 0 4.052 2.507z\" fill=\"#34A853\"/><path d=\"M7.079 12.05a2.709 2.709 0 0 1 0-1.735v-1.17H5.577a4.505 4.505 0 0 0 0 4.075l1.502-1.17z\" fill=\"#FBBC04\"/><path d=\"M9.629 8.44a2.452 2.452 0 0 1 1.74.68l1.3-1.293a4.37 4.37 0 0 0-3.065-1.183 4.53 4.53 0 0 0-4.027 2.5l1.502 1.171a2.715 2.715 0 0 1 2.55-1.875z\" fill=\"#EA4335\"/></svg>", "paypal": "<svg viewBox=\"0 0 38 24\" xmlns=\"http://www.w3.org/2000/svg\" width=\"57\" height=\"36\" role=\"img\" aria-hidden=\"true\"><path opacity=\".07\" d=\"M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z\"/><path fill=\"#fff\" d=\"M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32\"/><path fill=\"#003087\" d=\"M23.9 8.3c.2-1 0-1.7-.6-2.3-.6-.7-1.7-1-3.1-1h-4.1c-.3 0-.5.2-.6.5L14 15.6c0 .2.1.4.3.4H17l.4-3.4 1.8-2.2 4.7-2.1z\"/><path fill=\"#3086C8\" d=\"M23.9 8.3l-.2.2c-.5 2.8-2.2 3.8-4.6 3.8H18c-.3 0-.5.2-.6.5l-.6 3.9-.2 1c0 .2.1.4.3.4H19c.3 0 .5-.2.5-.4v-.1l.4-2.4v-.1c0-.2.3-.4.5-.4h.3c2.1 0 3.7-.8 4.1-3.2.2-1 .1-1.8-.4-2.4-.1-.5-.3-.7-.5-.8z\"/><path fill=\"#012169\" d=\"M23.3 8.1c-.1-.1-.2-.1-.3-.1-.1 0-.2 0-.3-.1-.3-.1-.7-.1-1.1-.1h-3c-.1 0-.2 0-.2.1-.2.1-.3.2-.3.4l-.7 4.4v.1c0-.3.3-.5.6-.5h1.3c2.5 0 4.1-1 4.6-3.8v-.2c-.1-.1-.3-.2-.5-.2h-.1z\"/></svg>"};
  var SHOPPER_COUNTRY = {{ localization.country.iso_code | default: 'US' | json }};

  // RedTrack / ad tracking: click IDs, UTMs and ad-platform IDs from cookies, storage and the page URL.
  // They are written onto the checkout session. Cookies set on madespecial.store are not visible on
  // checkout.madespecial.store, so the checkout restores them before its pixels fire.
  // AppLovin Axon: aleid/alart on the landing URL, pixel cookies _axeid/_axart/_axwrt, and _axon* (event id).
  // TikTok: ttclid on the landing URL, and the pixel cookie whose name is exactly _ttp.
  // Snapchat: ScCid / sc_click_id on the landing URL (also the ScCid cookie theme/snap-click-id.liquid sets),
  // pixel cookie _scid, and _scclid when the pixel stored the click id there.
  // Pinterest: epik on the landing URL, cookie _epik. Meta: fbclid, _fbp, _fbc.
  var TRACK = /clickid|^_*ref_id$|rtk|^utm_|fbclid|gclid|gbraid|wbraid|ttclid|msclkid|^_fbp$|^_fbc$|^_ga$|^aleid$|^alart$|^_axeid$|^_axart$|^_axwrt$|^_axon|^_ttp$|^sccid$|^sc_click_id$|^_scclid$|^_scid$|^os_version$|^device_model$|^_?epik$/i;
  // A real tracking value is a short ID or text: skip data blobs, JSON and binary that other apps keep in storage
  var GOOD = function (v) { return v.length <= 300 && !/^data:|^[\[{]/.test(v) && !/[\u0000-\u001f\u007f]/.test(v); };
  // Chrome's reduced UA hides the real OS version. userAgentData is filled in the background and copied at checkout.
  var snapDev = {};
  try {
    var uad = navigator.userAgentData;
    if (uad && uad.getHighEntropyValues) uad.getHighEntropyValues(['platformVersion', 'model']).then(function (h) {
      if (h && /^\d{1,3}(\.\d{1,4}){0,3}$/.test(h.platformVersion || '')) snapDev.os_version = h.platformVersion;
      if (h && h.model) snapDev.device_model = String(h.model).replace(/\s+/g, '').slice(0, 40);
    }).catch(function () {});
  } catch (e) {}
  // Fallback when theme/snap-click-id.liquid is not in <head> yet: still persist ScCid for this checkout.
  // The head snippet is what puts ScCid on the URL before the Snap pixel reads the page.
  try {
    var snapExp = Number(localStorage.getItem('ScCid_exp') || 0);
    if (snapExp && Date.now() > snapExp) { localStorage.removeItem('ScCid'); localStorage.removeItem('ScCid_exp'); }
  } catch (e) {}
  try {
    var scNow = '';
    new URLSearchParams(location.search).forEach(function (v, k) { if (!scNow && /^(?:sccid|sc_click_id)$/i.test(k)) scNow = v; });
    if (scNow && scNow.length >= 8 && scNow.length <= 500 && !/[\s{}<>]/.test(scNow)) {
      document.cookie = 'ScCid=' + encodeURIComponent(scNow) + '; Max-Age=2419200; Path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
      try { localStorage.setItem('ScCid', scNow); localStorage.setItem('ScCid_exp', String(Date.now() + 28 * 864e5)); } catch (e) {}
    }
  } catch (e) {}
  function trackingData() {
    var t = {};
    function put(k, v) { if (k && v && TRACK.test(k) && GOOD(String(v))) t[k] = String(v); }
    try { document.cookie.split(';').forEach(function (c) { var i = c.indexOf('='); if (i > 0) put(decodeURIComponent(c.slice(0, i).trim()), decodeURIComponent(c.slice(i + 1).trim())); }); } catch (e) {}
    try { for (var i = 0; i < localStorage.length; i++) { var k = localStorage.key(i); put(k, localStorage.getItem(k)); } } catch (e) {}
    try { new URLSearchParams(location.search).forEach(function (v, k) { put(k, v); }); } catch (e) {}
    if (snapDev.os_version) t.os_version = snapDev.os_version;
    if (snapDev.device_model && GOOD(snapDev.device_model)) t.device_model = snapDev.device_model;
    return t;
  }

  var box = document.getElementById('wh-load'), msg = document.getElementById('wh-msg'), closeBtn = document.getElementById('wh-close'), busy = false;
  var MSG = {
    price_mismatch: 'Your cart was just updated. Please check your cart and try again.',
    empty_cart: 'Your cart is empty.',
    cart_invalid: 'An item in your cart is no longer available. Please update your cart.'
  };
  function show(text, isErr) { msg.textContent = text; box.classList.toggle('err', !!isErr); closeBtn.hidden = !isErr; box.hidden = false; }
  closeBtn.onclick = function () { box.hidden = true; };
  window.addEventListener('pageshow', function () { busy = false; if (!box.classList.contains('err')) box.hidden = true; }); // back button from checkout (keeps an error message visible)

  // ---- speed: wake the checkout server and download the checkout's scripts before the shopper clicks ----
  // The store and checkout.madespecial.store are the same site, so files downloaded here are reused by the checkout page.
  var CART_COUNT = {{ cart.item_count | default: 0 }};
  var warmedAt = 0, prefetched = false;
  function warm() {
    if (Date.now() - warmedAt < 60000) return; warmedAt = Date.now(); // at most once a minute
    try { fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{"warmup":1}', keepalive: true }).catch(function () {}); } catch (e) {}
  }
  function prefetch() {
    if (prefetched) return; prefetched = true;
    ['https://cdn.whop.com/elements/amber/elements.js', 'https://cdn.jsdelivr.net/npm/libphonenumber-js@1.12.43/bundle/libphonenumber-min.js'].forEach(function (u) {
      var l = document.createElement('link'); l.rel = 'prefetch'; l.as = 'script'; l.href = u; l.crossOrigin = 'anonymous'; document.head.appendChild(l);
    });
  }
  function ready() { warm(); prefetch(); }
  var idle = window.requestIdleCallback || function (f) { return setTimeout(f, 1200); };
  idle(function () { warm(); if (CART_COUNT > 0) prefetch(); }, { timeout: 2500 });
  // The shopper is heading to checkout: cart drawer touched, checkout hovered/pressed, or something added to the cart
  ['pointerover', 'touchstart', 'focusin'].forEach(function (ev) {
    document.addEventListener(ev, function (e) {
      var t = e.target; if (!t || !t.closest) return;
      if (t.closest('[data-essential-cart-element]') || checkoutButton(t) || t.closest('a[href$="/cart"], [name="add"], form[action*="/cart/add"] [type="submit"]')) ready();
    }, { passive: true, capture: true });
  });
  // Back from the checkout server with a problem (cart changed, item unavailable): show the same message as before
  try {
    var qp = new URLSearchParams(location.search), ce = qp.get('checkout_error');
    if (ce) { show(MSG[ce] || 'Checkout is unavailable right now. Please try again in a moment.', true); qp.delete('checkout_error');
      history.replaceState(null, '', location.pathname + (qp.toString() ? '?' + qp : '') + location.hash); }
  } catch (e) {}

  // Essential Cart drawer: let Essential finish its own steps first (add or remove Shipping protection, upsells,
  // agreement checkbox), then take over at its official "before checkout" event with the final cart.
  document.addEventListener('essential-cart:before-checkout', function (e) { e.preventDefault(); go(); });

  document.addEventListener('click', function (e) {
    if (e.target && e.target.closest && e.target.closest('[data-essential-cart-element]')) return; // Essential handles it (event above)
    if (!checkoutButton(e.target)) return;
    e.preventDefault(); e.stopImmediatePropagation();
    go();
  }, true);

  async function go(opts) {
    opts = opts || {};
    if (busy) return; busy = true;
    show('Taking you to secure checkout…');
    try {
      var cart = await (await fetch('/cart.js', { cache: 'no-store' })).json();
      if (!cart.item_count) throw { code: 'empty_cart' };
      // Sent as a normal form post: the browser navigates straight to the checkout (no extra round trips)
      var payload = JSON.stringify({
          items: cart.items.map(function (i) { return { variant_id: i.variant_id, quantity: i.quantity, properties: i.properties || {} }; }),
          attributes: cart.attributes || {},
          discount_codes: (cart.discount_codes || []).filter(function (c) { return c.applicable !== false; }).map(function (c) { return c.code; }),
          total_price: cart.total_price,
          currency: cart.currency,
          market_country: (window.Shopify && Shopify.country) || SHOPPER_COUNTRY, // the Shopify Market whose currency the drawer shows
          tracking: trackingData(),
          consent: (function () { try { var p = window.Shopify && Shopify.customerPrivacy; return p ? { analytics: p.analyticsProcessingAllowed(), marketing: p.marketingAllowed() } : null; } catch (e) { return null; } })()
      });
      var f = document.createElement('form');
      f.method = 'POST'; f.action = ENDPOINT + (opts.x ? '?x=' + encodeURIComponent(opts.x) : ''); f.style.display = 'none';
      var inp = document.createElement('input'); inp.type = 'hidden'; inp.name = 'payload'; inp.value = payload; f.appendChild(inp);
      document.body.appendChild(f);
      try { if (window.clarity) clarity('event', 'go_to_checkout'); } catch (e) {}
      f.submit();
    } catch (err) {
      console.error('Whop checkout', err);
      show(MSG[err && err.code] || 'Checkout is unavailable right now. Please try again in a moment.', true);
      busy = false;
    }
  }
  // ---- express row ----
  function walletList() {
    var w = [];
    if (EXPRESS_PAYPAL) w.push(['paypal_express', 'PayPal', ICON.paypal]);
    try { if (window.ApplePaySession && ApplePaySession.canMakePayments()) w.push(['apple_pay', 'Apple Pay', ICON.apple_pay]); } catch (e) {}
    if (!/iPhone|iPad|iPod/.test(navigator.userAgent)) w.push(['google_pay', 'Google Pay', ICON.google_pay]);
    return w;
  }
  function expressRow() {
    var row = document.createElement('div'); row.className = 'wh-x';
    walletList().forEach(function (w) {
      var b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', 'Express checkout with ' + w[1]); b.innerHTML = w[2];
      b.addEventListener('click', function (e) { e.preventDefault(); e.stopPropagation(); go({ x: w[0] }); });
      row.appendChild(b);
    });
    return row.children.length ? row : null;
  }
  var placing = false;
  function placeExpress() {
    placing = false; if (!EXPRESS) return;
    document.querySelectorAll('[data-essential-cart-element="cart-drawer-checkout-button"], form[action*="/cart"] [name="checkout"]').forEach(function (btn) {
      var next = btn.nextElementSibling; if (next && next.classList.contains('wh-x')) return;
      var row = expressRow(); if (row) btn.insertAdjacentElement('afterend', row);
    });
  }
  if (EXPRESS) {
    new MutationObserver(function () { if (!placing) { placing = true; requestAnimationFrame(placeExpress); } }).observe(document.documentElement, { childList: true, subtree: true });
    placeExpress();
  }

  // Cart forms submitted with the keyboard (no click)
  document.addEventListener('submit', function (e) {
    var f = e.target; if (!f || !f.matches || !f.matches('form[action*="/cart"], form[action*="/checkout"]')) return;
    var sub = e.submitter; if (!(sub && sub.name === 'checkout') && !/checkout/.test(f.getAttribute('action') || '')) return;
    e.preventDefault(); e.stopImmediatePropagation();
    go();
  }, true);
})();
</script>