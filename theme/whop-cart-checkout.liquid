{%- comment -%}
  Essential Cart drawer / cart page "Checkout" -> your branded checkout page (checkout.madespecial.store),
  where the buyer enters contact + delivery details and pays with Whop's secure payment form.
  Kaching + Essential discounts stay as they are; the server re-prices the cart with Shopify.
  Paste in theme.liquid just before </body>. Set ENDPOINT to https://<your checkout domain>/api/checkout-session.
  Snap click IDs also need theme/snap-click-id.liquid pasted immediately after <head>, or the store pixel
  reads the page URL before ScCid is restored. Landers (lp1, uk/lp1) get theme/snap-click.js instead.
{%- endcomment -%}

<link rel="preconnect" href="https://checkout.madespecial.store">
<link rel="dns-prefetch" href="https://checkout.madespecial.store">
<div id="wh-load" role="status" aria-live="polite" hidden>
  <div class="wh-box">
    <div class="wh-spin" aria-hidden="true"></div>
    <p id="wh-msg">Taking you to secure checkout…</p>
    <button type="button" id="wh-close" hidden>Close</button>
  </div>
</div>
<style>
  body:has(.vsl-section) .blocky-announcement-bar, body:has(.vsl-section) .header-wrapper, body:has(.vsl-section) .footer{
    display: none;
  }
  #wh-load{position:fixed;inset:0;z-index:2147483647;background:rgba(0,0,0,.55);display:flex;align-items:center;justify-content:center;padding:16px}
  #wh-load[hidden]{display:none}
  #wh-load .wh-box{background:#fff;color:#1a1a1a;border-radius:14px;padding:24px 22px;max-width:360px;width:100%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.25);font:15px/1.45 inherit}
  #wh-load .wh-spin{width:34px;height:34px;margin:0 auto 12px;border:3px solid #e3e3e3;border-top-color:#1a1a1a;border-radius:50%;animation:whspin .8s linear infinite}
  #wh-load.err .wh-spin{display:none}
  #wh-load.err #wh-msg{color:#c0262d}
  #wh-load p{margin:0}
  #wh-close{margin-top:14px;padding:10px 18px;border:0;border-radius:8px;background:#1a1a1a;color:#fff;font:inherit;cursor:pointer}
  @keyframes whspin{to{transform:rotate(360deg)}}
  /* Shopify "Buy it now" / express buttons skip the cart and Whop: hidden so every order goes through our checkout */
  .wh-x{display:flex;gap:8px;margin:10px 0 0;width:100%}
  .wh-x button{flex:1;height:44px;border:1px solid #d1d5db;border-radius:8px;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0}
  .wh-x button svg{height:30px;width:auto}
  .wh-x button:hover{border-color:#9ca3af}
  .shopify-payment-button, shopify-accelerated-checkout, shopify-accelerated-checkout-cart, .additional-checkout-buttons, .dynamic-checkout__content { display: none !important; }
</style>
<script>
(function () {
  var ENDPOINT = 'https://checkout.madespecial.store/api/checkout-session';
  // Checkout buttons: Essential Cart drawer, theme drawer, cart page. Any button/link with the class "whop-checkout"
  // (or a class containing it) is caught too, and as a last resort any button whose text says "Checkout".
  var SEL = '.whop-checkout, [class*="whop-checkout"], [data-whop-checkout], .es-checkout-button, .es-checkout-btn, [class*="es-checkout"], ' +
            '[name="checkout"], a[href^="/checkout"], a[href*="/checkout?"], a[href*="/checkouts/"], button[onclick*="checkout"], form[action*="/checkout"] [type="submit"], .cart__checkout-button';
  function checkoutButton(t) {
    if (!t || !t.closest || t.closest('#wh-load')) return null;
    var el = t.closest(SEL); if (el) return el;
    var c = t.closest('button, a, input[type="submit"], [role="button"]'); if (!c) return null;
    var txt = (c.value || c.textContent || '').replace(/\s+/g, ' ').trim();
    if (txt.length > 40 || !/\bcheck\s?-?out\b/i.test(txt)) return null;
    var h = c.tagName === 'A' ? (c.getAttribute('href') || '') : '';
    if (h && !/checkout|^#|^javascript/i.test(h)) return null; // a "checkout" link to some other page
    return c;
  }
  // Express buttons under the Essential drawer's checkout button and the cart page's checkout button.
  // They open our checkout with that wallet ready (Shopify's own Shop Pay / G Pay buttons can't use Whop).
  var EXPRESS = true;          // false = don't show them
  var EXPRESS_PAYPAL = true;   // PayPal is approved on the Whop account
