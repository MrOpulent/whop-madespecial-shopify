{%- liquid
  assign rs_opt = product.options_with_values | where: 'name', 'Colour' | first
  if rs_opt == blank
    assign rs_opt = product.options_with_values | first
  endif
-%}
{%- comment -%} Rainsong landing: hero gallery. Color slides come from each color variant's own image. {%- endcomment -%}
{{ 'rainsong.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<script src="{{ 'rainsong.js' | asset_url }}" defer></script>
<script src="{{ 'rainsong-addons.js' | asset_url }}" defer></script>
<link rel="preconnect" href="https://checkout.madespecial.store"><link rel="dns-prefetch" href="https://trk.madespecial.store">
<script type="application/json" id="rs-data">{"currency":{{ cart.currency.iso_code | json }},"variants":{ {%- for v in product.variants -%}{{ v.option1 | json }}:{{ v.id }}{% unless forloop.last %},{% endunless %}{%- endfor -%} }}</script><div class="rs rs-top"><section class="gal rs-gal" aria-roledescription="carousel" aria-label="Product images"><div class="track" id="track">
<figure class="slide" data-colour="Teal"><img src="{{ 'rainsong-hero-xmas.jpg' | file_img_url: '1000x' }}" alt="Margaret’s Rain Drum in an open green gift box with a red velvet ribbon, wrapped presents and a lit Christmas tree" fetchpriority="high" width="1000" height="750" draggable="false"></figure>
<figure class="slide" data-colour="Teal" data-kit="1"><img src="{{ 'rainsong-kit-package.jpg' | file_img_url: '1000x' }}" alt="What comes with your package: the drum, padded bag, guide book, mallets, pouch, finger picks, number stickers and cleaning cloth" class="ct" width="1000" height="750" draggable="false"></figure>
<figure class="slide" data-colour="Teal"><img src="{{ 'rainsong-porch-rain.jpg' | file_img_url: '1000x' }}" alt="The drum on a garden table in light rain" loading="lazy" width="1000" height="750" draggable="false"></figure>
{%- assign v = rs_opt.values[0] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<figure class="slide" data-colour="{{ v | escape }}" data-render="1"><img src="{{ vm | image_url: width: 1000 }}" alt="{{ v | escape }} drum" loading="lazy" width="1000" height="750" draggable="false"><figcaption>{{ v }}</figcaption></figure>
<figure class="slide" data-colour="Teal"><img src="{{ 'rainsong-flatlay-keep-give.jpg' | file_img_url: '1000x' }}" alt="One open box with the drum and mallets, one wrapped box" loading="lazy" width="1000" height="750" draggable="false"></figure>
{%- assign v = rs_opt.values[1] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<figure class="slide" data-colour="{{ v | escape }}" data-render="1"><img src="{{ vm | image_url: width: 1000 }}" alt="{{ v | escape }} drum" loading="lazy" width="1000" height="750" draggable="false"><figcaption>{{ v }}</figcaption></figure>
<figure class="slide" data-colour="Teal"><img src="{{ 'rainsong-under-tree.jpg' | file_img_url: '1000x' }}" alt="Two gift boxes under a Christmas tree" loading="lazy" width="1000" height="750" draggable="false"></figure>
{%- assign v = rs_opt.values[2] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<figure class="slide" data-colour="{{ v | escape }}" data-render="1"><img src="{{ vm | image_url: width: 1000 }}" alt="{{ v | escape }} drum" loading="lazy" width="1000" height="750" draggable="false"><figcaption>{{ v }}</figcaption></figure>
<figure class="slide" data-colour=""><img src="{{ 'rainsong-hands-gift.jpg' | file_img_url: '1000x' }}" alt="Two pairs of hands passing a wrapped gift" loading="lazy" width="1000" height="750" draggable="false"></figure>
{%- assign v = rs_opt.values[3] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<figure class="slide" data-colour="{{ v | escape }}" data-render="1"><img src="{{ vm | image_url: width: 1000 }}" alt="{{ v | escape }} drum" loading="lazy" width="1000" height="750" draggable="false"><figcaption>{{ v }}</figcaption></figure>
{%- assign v = rs_opt.values[4] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<figure class="slide" data-colour="{{ v | escape }}" data-render="1"><img src="{{ vm | image_url: width: 1000 }}" alt="{{ v | escape }} drum" loading="lazy" width="1000" height="750" draggable="false"><figcaption>{{ v }}</figcaption></figure>
</div>
<button type="button" class="arw p" aria-label="Previous image" data-go="prev"><svg class="ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button><button type="button" class="arw n" aria-label="Next image" data-go="next"><svg class="ic" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
<span class="count num" id="cnt" aria-live="polite">1 / 11</span>
<button type="button" class="listen" data-scroll="rs-videos"><span class="pb"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5z" fill="currentColor" stroke="none"/></svg></span><span>Hear it in the rain<small>Customer videos</small></span></button></section>
<div class="thumbs" id="thumbs"><button type="button" aria-label="Image 1" data-go="0"><img src="{{ 'rainsong-hero-xmas.jpg' | file_img_url: '160x' }}" alt="" loading="lazy" width="160" height="120"></button><button type="button" aria-label="Image 2" data-go="1"><img src="{{ 'rainsong-kit-package.jpg' | file_img_url: '160x' }}" alt="" loading="lazy" width="160" height="120"></button><button type="button" aria-label="Image 3" data-go="2"><img src="{{ 'rainsong-porch-rain.jpg' | file_img_url: '160x' }}" alt="" loading="lazy" width="160" height="120"></button>{%- assign v = rs_opt.values[0] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<button type="button" aria-label="Image 4: {{ v | escape }}" data-go="3"><img src="{{ vm | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="120"></button><button type="button" aria-label="Image 5" data-go="4"><img src="{{ 'rainsong-flatlay-keep-give.jpg' | file_img_url: '160x' }}" alt="" loading="lazy" width="160" height="120"></button>{%- assign v = rs_opt.values[1] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<button type="button" aria-label="Image 6: {{ v | escape }}" data-go="5"><img src="{{ vm | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="120"></button><button type="button" aria-label="Image 7" data-go="6"><img src="{{ 'rainsong-under-tree.jpg' | file_img_url: '160x' }}" alt="" loading="lazy" width="160" height="120"></button>{%- assign v = rs_opt.values[2] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<button type="button" aria-label="Image 8: {{ v | escape }}" data-go="7"><img src="{{ vm | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="120"></button><button type="button" aria-label="Image 9" data-go="8"><img src="{{ 'rainsong-hands-gift.jpg' | file_img_url: '160x' }}" alt="" loading="lazy" width="160" height="120"></button>{%- assign v = rs_opt.values[3] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<button type="button" aria-label="Image 10: {{ v | escape }}" data-go="9"><img src="{{ vm | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="120"></button>{%- assign v = rs_opt.values[4] -%}{%- assign vv = product.variants | where: 'option1', v | first -%}{%- assign vm = vv.featured_media | default: product.featured_media -%}<button type="button" aria-label="Image 11: {{ v | escape }}" data-go="10"><img src="{{ vm | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="120"></button></div><div id="rs-unbox-slot" class="rs-unbox-slot"></div></div>
