{%- comment -%} Not on sale yet (draft/preview): Shopify rejects the add ("Cannot find variant") and the store's cart sends people to an empty /cart. Show a clear message instead. Renders nothing once the product is published. {%- endcomment -%}
{%- if product.published_at == blank -%}
<div id="rs6-notsale" role="alert" aria-live="assertive" hidden style="position:fixed;left:50%;bottom:96px;transform:translateX(-50%);z-index:2147483000;width:min(92vw,440px);box-sizing:border-box;background:#0F2A1F;color:#fff;border-radius:14px;padding:14px 18px;font:500 15px/1.4 inherit;box-shadow:0 10px 30px rgba(0,0,0,.25);text-align:center">This drum isn’t on sale yet. You’re viewing a preview, so Add to bag is turned off until it launches.</div>
<script>
(function(){var m=document.getElementById('rs6-notsale'),t=0;
function hit(x){return x&&x.closest&&x.closest('form.blocky-product-form [data-blocky-add-button], .rs [data-atc], form[action*="/cart/add"] [type=submit]')}
function stop(e){if(!hit(e.target))return;e.preventDefault();e.stopImmediatePropagation();
  m.hidden=false;clearTimeout(t);t=setTimeout(function(){m.hidden=true},6000);
  document.documentElement.classList.remove('rs-adding')}
window.addEventListener('click',stop,true);
window.addEventListener('submit',function(e){var f=e.target;if(f&&f.matches&&f.matches('form.blocky-product-form, form[action*="/cart/add"]')){e.preventDefault();e.stopImmediatePropagation()}},true);
})();
</script>
{%- endif -%}
