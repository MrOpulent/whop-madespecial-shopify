{%- liquid
  assign rs_opt = product.options_with_values | where: 'name', 'Colour' | first
  if rs_opt == blank
    assign rs_opt = product.options_with_values | first
  endif
-%}
{%- liquid
  assign rs_v = product.selected_or_first_available_variant
  assign rs_unit = rs_v.price
  assign rs_cmp = rs_v.compare_at_price | default: rs_v.price
  assign rs_head = rs_heading | default: 'Margaret’s Rain Drum'
  assign p2t = 29999
  assign p2 = p2t | plus: 1 | divided_by: 2
  assign p2w = rs_cmp | times: 2
  assign p2s = p2w | minus: p2t
  assign p2c = p2s | times: 100 | divided_by: p2w
  assign p1s = rs_cmp | minus: rs_unit
  assign p1c = p1s | times: 100 | divided_by: rs_cmp
-%}
<style id="rs-price-boot">.blocky-featured-product:has(.rs-top) .blocky-product-submit{--rs-price:{{ rs_unit | money | json }}}</style>
<div class="rs rs-info">
<div class="pinfo"><p class="eyebrow"><span class="bfchip">Black Friday</span><span class="hot">🔥 Selling FAST! (Last Units Available)</span></p>
<h1>*NEW* Hand Tuned Rain Drum <span class="sz">(10 inch - XL)</span></h1><p class="sub">A gift that plays itself when it rains.</p>
<div class="priceline"><span class="p num" id="pp">{{ rs_unit | money }}</span><s class="num" id="ps">{{ rs_cmp | money }}</s><span class="off num" id="po">{{ p1c }}% off</span></div>
<p class="pq num" id="pq"><b>{{ rs_unit | money }} for one drum.</b> 2 drums: {{ p2 | money }} each.</p>
<button type="button" class="ribbon" data-scroll="box"><span class="imgs" aria-hidden="true"><img src="{{ 'rainsong-kit-bag.jpg' | file_img_url: '96x' }}" alt="" width="48" height="48"><img src="{{ 'rainsong-kit-book.jpg' | file_img_url: '96x' }}" alt="" width="48" height="48"><img src="{{ 'rainsong-kit-mallets.jpg' | file_img_url: '96x' }}" alt="" width="48" height="48"><img src="{{ 'rainsong-kit-picks.jpg' | file_img_url: '96x' }}" alt="" width="48" height="48"><img src="{{ 'rainsong-kit-stickers.jpg' | file_img_url: '96x' }}" alt="" width="48" height="48"><i class="m5">+2</i><i class="m3">+4</i></span><span class="t"><b>Included free</b>7 bonuses with every drum</span><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button></div>
<fieldset class="sets" id="buy"><legend class="vh">Choose your set</legend><div class="sethead" aria-hidden="true"><p class="eyebrow" style="margin:0">Choose your set</p><span>Prices in {{ cart.currency.iso_code }}</span></div>
{%- liquid
  assign per = rs_unit
  assign tot = rs_unit
  assign was = rs_cmp | times: 1
  assign save = was | minus: tot
  assign pc = save | times: 100 | divided_by: was
-%}<div class="set on" data-q="1" data-name="Just for me"><label class="sl"><input class="vh" type="radio" name="set" value="1" checked><span class="r" aria-hidden="true"></span><span class="sb"><span class="n">Just for me</span><span class="m">1 drum<span class="nb"> · <b class="sv" data-f="save">Save {{ save | divided_by: 100 | times: 100 | money_without_trailing_zeros }}</b></span></span></span><span class="pr num"><b data-f="tot">{{ tot | money }}</b><s data-f="was">{{ was | money }}</s><span class="pc" data-f="pc">{{ pc }}% off</span></span></label><div class="incl"><div class="cl"><span class="cn">Drum 1 <small>· color</small></span><span class="sws" role="radiogroup" aria-label="Drum 1 color">{%- for v in rs_opt.values -%}<label class="sw" title="{{ v | escape }}"><input class="vh" type="radio" name="c00" value="{{ v | escape }}"{% if forloop.index0 == 0 %} checked{% endif %} aria-label="{{ v | escape }}"><i style="background:{%- case v -%}{%- when 'Teal' -%}#1F6B67{%- when 'Black' -%}#2E3230{%- when 'Purple' -%}#9C86C4{%- when 'Aqua' -%}#93CFCB{%- when 'Golden' -%}#C9A13B{%- else -%}#888{%- endcase -%}"></i></label>{%- endfor -%}</span></div><p class="kitline"><svg class="ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="8" width="17" height="4"/><path d="M5 12v8h14v-8M12 8v12M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zm0 0c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg><span>1 bonus kit included free · 7 pieces</span></p></div></div>
