<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'snap-click-id' %}
        <script>
    (function () {
      'use strict';

      var DAYS          = 30;
      var FIRST_TOUCH   = false;   /* false = newest non-blank value wins */
      var COOKIE_DOMAIN = '';     /* '.madespecial.store' to share with the checkout subdomain */

      var PREFIX = [/^utm_/i, /^tw_/i];

      var EXACT = {
        'ref_id': 'ref_id',
        '_ref_id': 'ref_id',
        'cmpid': 'cmpid',
        'ttclid': 'ttclid',
        'sccid': 'ScCid',
        'sc_click_id': 'ScCid',
        'epik': 'epik'
      };

      var META    = '__ms_tp_meta';
      var MAX_AGE = DAYS * 864e5;
      var has     = Object.prototype.hasOwnProperty;

      function valid(v) {
        if (v === null || v === undefined) return false;
        v = String(v).trim();
        if (!v || v.length > 300) return false;
        if (/^(?:null|undefined|none|n\/a|0)$/i.test(v)) return false;
        if (/^data:|^[\[{]/.test(v)) return false;
        if (/^__[A-Z0-9_]+__$/i.test(v)) return false;
        if (/[\u0000-\u001f\u007f]/.test(v)) return false;
        return true;
      }

      function nameFor(key) {
        var k = String(key || '').trim();
        if (!k) return null;
        var low = k.toLowerCase();
        if (has.call(EXACT, low)) return EXACT[low];
        for (var i = 0; i < PREFIX.length; i++) if (PREFIX[i].test(k)) return low;
        return null;
      }

      function readCookie(name) {
        try {
          var all = document.cookie.split(';');
          for (var i = 0; i < all.length; i++) {
            var c = all[i], eq = c.indexOf('=');
            if (eq < 1) continue;
            if (decodeURIComponent(c.slice(0, eq).trim()) === name) {
              var v = decodeURIComponent(c.slice(eq + 1).trim());
              return v === 'undefined' ? '' : v;
            }
          }
        } catch (e) {}
        return '';
      }

      function writeCookie(name, value, maxAgeSeconds) {
        try {
          document.cookie = encodeURIComponent(name) + '=' + encodeURIComponent(value) +
            '; Max-Age=' + maxAgeSeconds + '; Path=/' +
            (COOKIE_DOMAIN ? '; Domain=' + COOKIE_DOMAIN : '') +
            '; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
        } catch (e) {}
      }

      function lsGet(k) { try { return localStorage.getItem(k) || ''; } catch (e) { return ''; } }
      function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
      function lsDel(k) { try { localStorage.removeItem(k); } catch (e) {} }

      var m = null;
      try {
        var raw = lsGet(META);
        if (raw) {
          m = JSON.parse(raw);
          if (!m || typeof m !== 'object') m = null;
          else if (!Array.isArray(m.keys)) m.keys = [];
        }
      } catch (e) { m = null; }

      if (m && m.exp && Date.now() > m.exp) {
        m.keys.forEach(function (k) { lsDel(k); writeCookie(k, '', 0); });
        lsDel(META);
        m = null;
      }
      if (!m) m = { exp: Date.now() + MAX_AGE, keys: [] };

      var stored = 0;

      try {
        new URLSearchParams(location.search).forEach(function (rawValue, rawKey) {
          var name = nameFor(rawKey);
          if (!name) return;

          var value = String(rawValue).trim();
          if (!valid(value)) return;

          if (m.keys.indexOf(name) === -1) m.keys.push(name);

          var existing = lsGet(name) || readCookie(name);
          if (existing === value) return;
          if (existing && FIRST_TOUCH) return;

          lsSet(name, value);
          writeCookie(name, value, Math.floor((m.exp - Date.now()) / 1000));
          stored++;
        });
      } catch (e) {}

      try {
        var left = Math.floor((m.exp - Date.now()) / 1000);
        if (left > 0) m.keys.forEach(function (k) {
          var ls = lsGet(k), ck = readCookie(k);
          if (ls && !ck) writeCookie(k, ls, left);
          else if (ck && !ls) lsSet(k, ck);
        });
      } catch (e) {}

      if (m.keys.length) lsSet(META, JSON.stringify(m));

      window.MSTrackParams = function () {
        var out = { expires: new Date(m.exp).toISOString(), storedThisLoad: stored, values: {} };
        m.keys.forEach(function (k) { out.values[k] = { ls: lsGet(k), cookie: readCookie(k) }; });
        return out;
      };
    })();
    </script>
