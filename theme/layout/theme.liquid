{%- if product and product.handle == 'steel-tongue-rain-drum-es' -%}
<script>
(function () {
  var MAP = {
    "Add To Cart – Save Up To 30%": "Añadir al carrito – Ahorra hasta un 30%",
    "Steel Tongue Rain Drum – 9-Note": "Tambor de lluvia de acero – 9 notas",
    "Regular price:": "Precio habitual:",
    "Sale price:": "Precio de oferta:",
    "Sold out": "Agotado"
  };
  function translate(root) {
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT), node;
    while ((node = walker.nextNode())) {
      var t = node.nodeValue.trim();
      if (MAP[t]) node.nodeValue = node.nodeValue.replace(t, MAP[t]);
    }
  }
  function start() {
    var bar = document.getElementById('sticky-cart-portal');
    if (!bar) return false;
    translate(bar);
    new MutationObserver(function () { translate(bar); })
      .observe(bar, { childList: true, subtree: true, characterData: true });
    return true;
  }
  if (!start()) {
    var wait = new MutationObserver(function () { if (start()) wait.disconnect(); });
    wait.observe(document.documentElement, { childList: true, subtree: true });
  }
})();
</script>
