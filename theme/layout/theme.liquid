{%- comment -%} 6-inch page (product 15516011856054) only: never swap it via ?v= (a ?v=<anything> link rendered the old default product page). All other products keep the ?v= behavior. {%- endcomment -%}
{%- unless product.id == 15516011856054 or product.id == 15423518245046 -%}
 <script>
(function () {
  try {
    /* Products only - pages, collections, home are left alone. */
    if (location.pathname.indexOf('/products/') === -1) return;

    var p = new URLSearchParams(location.search);
    var v = p.get('v');
    if (!v) return;

    /* Old links keep working: ?v=y still loads product.v2.json */
    var ALIAS = { 'y': 'v2' };
    var suffix = ALIAS[v] || v;

    /* Already rendered - clean the address bar back to ?v=... */
    if (p.get('view') === suffix) {
      p.delete('view');
      var q = p.toString();
      history.replaceState(null, '',
        location.pathname + (q ? '?' + q : '') + location.hash);
      return;
    }
    if (p.has('view')) return;

    /* Only safe characters, so a junk value cannot build a strange URL. */
    if (!/^[a-z0-9-]{1,60}$/i.test(suffix)) return;

    p.set('view', suffix);
    location.replace(location.pathname + '?' + p.toString() + location.hash);
  } catch (e) {}
})();
</script>
{%- endunless -%}
{%- comment -%} 6-inch page only: if opened with ?view=<other> it goes back to its own template, keeping ?v= and every other parameter. {%- endcomment -%}
{%- assign ms_own_tpl = false -%}{%- if product.id == 15516011856054 or product.id == 15423518245046 -%}{%- assign ms_own_tpl = true -%}{%- endif -%}
{%- if request.page_type == 'product' and ms_own_tpl and template.suffix != product.template_suffix -%}
<script>
(function () {
  try {
    var p = new URLSearchParams(location.search);
    if (!p.has('view')) return;
    p.delete('view');
    var q = p.toString();
    location.replace(location.pathname + (q ? '?' + q : '') + location.hash);
  } catch (e) {}
})();
</script>
{%- endif -%}

