    "blocky_faq_with_media_yLP4aB": {
      "type": "blocky-faq-with-media",
      "blocks": {
        "question_FHEeER": {
          "type": "question",
          "settings": {
            "question": "Will the rain really play it?",
            "content": "<p>Yes, in a steady rain. A light mist is too soft to ring steel, so set it where the big drops fall: under the drip edge of a roof, a gutter or a dripping branch. On dry days, the mallet lets you play it yourself.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_dQKUFa": {
          "type": "question",
          "settings": {
            "question": "Is it really tuned by hand?",
            "content": "<p>Yes. Evelyn tunes every tongue herself, by ear, to 432Hz. There is no machine for it. This batch is the last one she will tune.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_kUwGrT": {
          "type": "question",
          "settings": {
            "question": "I've never played music. Can I play it?",
            "content": "<p>There is no wrong note. The nine tongues are pentatonic, so any note you strike sounds right next to any other. Grandchildren love it for the same reason.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_WbHagV": {
          "type": "question",
          "settings": {
            "question": "Can it stay outside all year?",
            "content": "<p>Yes. It is weather-hardened steel, made to live outdoors through every season. Evelyn's own has sat on the same stump for ten years.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        },
        "question_rPjYEL": {
          "type": "question",
          "settings": {
            "question": "What if it doesn't win me over?",
            "content": "<p>Send it back within 30 days for a full refund. One email to our team is all it takes.</p>",
            "default_open": false,
            "icon_code": "",
            "icon_color": "#000000"
          }
        }
      },
