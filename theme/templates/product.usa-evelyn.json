    "blocky_image_with_text_rHCDjp": {
      "type": "blocky-image-with-text",
      "blocks": {
        "title_mMgHRU": {
          "type": "title",
          "settings": {
            "title": "\"I Forgot A Piece Of Steel Out In The Rain\"",
            "title_size": 42,
            "title_color": "#000000"
          }
        },
        "body_TWhUHQ": {
          "type": "body",
          "settings": {
            "body_text": "<p>\"My name is Evelyn Carter. I am 68, and I have shaped steel in this forge for 30 years.</p><p>Ten years ago I left a piece of steel outside. Then a storm came through, and I heard it singing. Every raindrop, one clean note.</p><p>I have made nothing else since.\"</p>",
            "body_size": 18,
            "body_color": "#000000"
          }
        }
      },
      "block_order": [
        "title_mMgHRU",
        "body_TWhUHQ"
      ],
