          "settings": {
            "title": "The Last Batch",
            "title_size": 42,
            "title_color": "#000000"
          }
        },
        "body_cGnrXT": {
          "type": "body",
          "settings": {
            "body_text": "<p>\"Two winters ago the arthritis got the fingers I tune with. So this is the last batch. I tuned every one myself, then set the hammer down for good.</p><p>A hand-tuned drum runs $400 and up. I am letting the last ones go at cost. I just need them played by the rain, not sitting on a shelf.\"</p><p><em>— </em>Evelyn</p>",
            "body_size": 18,
            "body_color": "#000000"
          }
        },
