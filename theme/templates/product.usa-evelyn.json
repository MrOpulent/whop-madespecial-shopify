        "custom_liquid_4UC37j": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Set the country once, on the visitor's first arrival. After that the\n  country belongs to the visitor - we never override it again.\n{%- endcomment -%}\n{%- assign bky_cc = 'US' -%}\n\n{%- if localization.country.iso_code != bky_cc -%}\n  {%- form 'localization', id: 'bky-force-country' -%}\n    <input type=\"hidden\" name=\"country_code\" value=\"{{ bky_cc }}\">\n    <input type=\"hidden\" name=\"return_to\" value=\"{{ request.path }}\">\n  {%- endform -%}\n  <script>\n  (function () {\n    var KEY = 'bkyCountryForced';\n    var f = document.getElementById('bky-force-country');\n    if (!f) return;\n\n    try {\n      /* Already handled once - this country is the visitor's own choice. */\n      if (localStorage.getItem(KEY)) return;\n      localStorage.setItem(KEY, '1');\n    } catch (e) {\n      /* Storage blocked. Do nothing rather than risk a reload loop. */\n      return;\n    }\n\n    f.querySelectorAll('[name=\"return_to\"]').forEach(function (i) {\n      i.value = location.pathname + location.search;\n    });\n    f.submit();\n  })();\n  </script>\n{%- else -%}\n  <script>\n    /* Visitor is already on the target country. Mark it as handled so a\n       later manual switch is never pulled back. */\n    try { localStorage.setItem('bkyCountryForced', '1'); } catch (e) {}\n  </script>\n{%- endif -%}"
          }
        },
        "custom_liquid_E7exYd": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<h1 class=\"blocky-title\" style=\"font-size:clamp(30px,3.2vw,42px);margin:0 0 8px;font-weight:400;line-height:1.12\">Evelyn's Hand-Tuned Rain Drum</h1>\n<p style=\"margin:0 0 14px;color:#8B1E2D;font-weight:700;letter-spacing:.6px;text-transform:uppercase;font-size:15px\">\n    &#9679; Last Batch. Only 16 Left</p>\n<div style=\"display:flex;align-items:center;gap:14px;margin:4px 0\"><img\n        src=\"https://cdn.shopify.com/s/files/1/0793/6360/4662/files/Warm_Artisan_in_Her_Workshop.png?v=1793786543\" width=\"58\" height=\"58\" alt=\"Evelyn Carter\"\n        style=\"width:58px;height:58px;border-radius:50%;object-fit:cover;border:2px solid #4A6D7C;flex:0 0 58px\">\n    <p style=\"margin:0;font-style:italic;color:#1f3540;line-height:1.45\">\"This turns rain into music.\"<br><span\n            style=\"font-style:normal;color:#4A6D7C\">— Evelyn Carter, 68</span></p>\n</div>\n<style>\n    @media(max-width:749px) {\n        .kaching-bundles__bar-first-line {\n            flex-direction: column !important;\n            align-items: flex-start !important;\n            gap: 4px !important\n        }\n\n        .kaching-bundles__bar-label {\n            margin-left: 0 !important\n        }\n\n        .blocky-product-description,\n        .blocky-product-description p,\n        .blocky-product-collapsible,\n        .blocky-product-collapsible p,\n        .blocky-product-collapsible summary {\n            font-size: 16px !important;\n            line-height: 1.5 !important\n        }\n\n        [id*=scrolling_text_bar] * {\n            font-size: 14px !important\n        }\n\n        [id*=product_icons] p,\n        [id*=product_icons] [class*=description] {\n            font-size: 15px !important;\n            line-height: 1.5 !important\n        }\n    }\n\n    .blocky-product-submit,\n    .blocky-product-submit * {\n        font-size: 19px !important\n    }\n</style>\n<style>\n    #tidio-chat,\n    #tidio-chat-iframe {\n        display: none !important;\n        visibility: hidden !important;\n        pointer-events: none !important\n    }\n</style>\n<script>(function () { function h() { try { if (window.tidioChatApi) { window.tidioChatApi.hide(); } } catch (e) { } var el = document.getElementById('tidio-chat'); if (el) { el.style.setProperty('display', 'none', 'important'); } } document.addEventListener('tidioChat-ready', h); document.addEventListener('tidioChat-open', h); var n = 0; var t = setInterval(function () { h(); if (++n > 40) { clearInterval(t); } }, 500); })();</script>"
          }
        },
        "custom_liquid_hN4dEQ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"blocky-product-description\" style=\"color: #000000; font-size: 18px; text-align: left; margin-top: 0rem; margin-bottom: 0rem; line-height: 1.8; letter-spacing: 0.6px;\">\n<p>🌧 Set it outside and the rain plays it. Every drop lands on one clean note.</p>\n<p>🎵 Nine steel tongues in a pentatonic scale — there is no wrong note.</p>\n<p>🌳 Weather-resistant steel, made to sit outdoors year-round.</p>\n<p>Includes a mallet to play the drum with on dry days.</p>\n\n</div>"
          }
        },
