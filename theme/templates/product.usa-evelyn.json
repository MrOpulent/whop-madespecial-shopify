    "blocky_testimonials_4EUcwx": {
      "type": "blocky-testimonials",
      "blocks": {
        "title_Ci898W": {
          "type": "title",
          "settings": {
            "title": "Why People Bring One Home",
            "title_size": 48,
            "title_color": "#000000"
          }
        },
        "testimonial_rmdRQb": {
          "type": "testimonial",
          "settings": {
            "image_1": "shopify://shop_images/image_6.png",
            "heading_1": "Instead Of Wind Chimes",
            "desc_1": "",
            "author_1": "No tangled strings. No clanging at 3 a.m. Nothing for the wind to tear down. It only sings when the rain comes, and it gets better the harder it falls.",
            "location_1": "",
            "image_2": "shopify://shop_images/image_7.png",
            "heading_2": "For The Grandchildren",
            "desc_2": "",
            "author_2": "There is no wrong note on one of these. A four-year-old and a grandmother can sit on the porch and play it together, and every song comes out sounding right.",
            "location_2": "",
            "image_3": "shopify://shop_images/image_1_14f5fe86-d5ca-445e-a63c-b225f5fde536.png",
            "heading_3": "For A Slower Afternoon",
            "desc_3": "",
            "author_3": "When the clouds come in, put the kettle on, sit by the window and let the weather play for you. It makes you look forward to a rainy day.",
            "location_3": "",
            "heading_color": "#000000",
