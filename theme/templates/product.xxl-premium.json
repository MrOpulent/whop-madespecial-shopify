    "rs_who_slider": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"rswho\" id=\"rswho\">\n<p class=\"rswho-eyebrow\">Make it a gift</p>\n<h2 class=\"rswho-h\">Who’s it for?</h2>\n<div class=\"rswho-wrap\">\n<button type=\"button\" class=\"rswho-nav rswho-prev\" aria-label=\"Previous\">&#8249;</button>\n<div class=\"rswho-track\" tabindex=\"0\" aria-label=\"Who it's for\">\n<article class=\"rswho-card\"><img src=\"https://cdn.shopify.com/s/files/1/0793/6360/4662/files/Enlarged_teal_rain_drum_in_gift_box.jpg?v=1795785353&width=800\" alt=\"A grandmother and her granddaughter open a gift box with the teal rain drum inside\" width=\"800\" height=\"600\" loading=\"lazy\"><div class=\"rswho-body\"><h3>Grandkids</h3><p>For the grandkids. A gift from you they’ll play every time it rains.</p></div></article>\n<article class=\"rswho-card\"><img src=\"{{ 'rainsong-who-mum.jpg' | file_img_url: '800x' }}\" alt=\"A daughter hands her mother a wrapped gift\" width=\"800\" height=\"600\" loading=\"lazy\"><div class=\"rswho-body\"><h3>Mom</h3><p>For the garden she loves. Send it straight to her door.</p></div></article>\n<article class=\"rswho-card\"><img src=\"{{ 'rainsong-who-grandma.jpg' | file_img_url: '800x' }}\" alt=\"A grandmother laughs as her grandson gives her a gift\" width=\"800\" height=\"600\" loading=\"lazy\"><div class=\"rswho-body\"><h3>Grandma</h3><p>Big numbered notes and a guide book: she'll be playing her first carol in minutes.</p></div></article>\n<article class=\"rswho-card\"><img src=\"{{ 'rainsong-who-friend.jpg' | file_img_url: '800x' }}\" alt=\"Two friends exchange a wrapped gift by a Christmas tree\" width=\"800\" height=\"600\" loading=\"lazy\"><div class=\"rswho-body\"><h3>A friend</h3><p>For the friend who has everything. She won't have one of these.</p></div></article>\n<article class=\"rswho-card\"><img src=\"{{ 'rainsong-who-me.jpg' | file_img_url: '800x' }}\" alt=\"A woman unties the ribbon on a gift to herself by a rainy window\" width=\"800\" height=\"600\" loading=\"lazy\"><div class=\"rswho-body\"><h3>Me</h3><p>Go on. A little concert on the porch every time it rains.</p></div></article>\n</div>\n<button type=\"button\" class=\"rswho-nav rswho-next\" aria-label=\"Next\">&#8250;</button>\n</div>\n<div class=\"rswho-dots\" aria-hidden=\"true\"></div>\n<p class=\"rswho-ship\"><span>&#10003;</span> <strong>Ship it straight to them.</strong> Add their address at checkout. Free.</p>\n</div>\n<style>\n.rswho{max-width:1240px;margin:0 auto;padding:0 20px;text-align:center}\n.rswho-eyebrow{font-family:\"Nunito Sans\",sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;color:#8a6a4f;margin:0 0 8px}\n.rswho-h{font-family:Lora,serif;font-weight:400;font-size:clamp(32px,4vw,48px);line-height:1.1;color:#000;margin:0 0 28px}\n.rswho-wrap{position:relative}\n.rswho-track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:4px 4px 12px;scrollbar-width:none;-webkit-overflow-scrolling:touch}\n.rswho-track::-webkit-scrollbar{display:none}\n.rswho-card{flex:0 0 calc((100% - 48px)/3);scroll-snap-align:start;background:#fff;border-radius:15px;box-shadow:rgba(0,0,0,.12) 0 2px 4px;overflow:hidden;text-align:left;display:flex;flex-direction:column}\n.rswho-card img{display:block;width:calc(100% - 32px);margin:16px 16px 0;aspect-ratio:4/3;object-fit:cover;border-radius:8px;height:auto}\n.rswho-body{padding:20px 24px 26px}\n.rswho-body h3{font-family:\"Nunito Sans\",sans-serif;font-size:22px;font-weight:400;color:#000;margin:0 0 10px}\n.rswho-body p{font-family:\"Nunito Sans\",sans-serif;font-size:18px;line-height:1.45;color:#000;margin:0}\n.rswho-nav{position:absolute;top:38%;width:44px;height:44px;border-radius:50%;border:1px solid #d98e5f;background:#fff;color:#d98e5f;font-size:28px;line-height:1;cursor:pointer;z-index:2;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.08)}\n.rswho-prev{left:-22px}.rswho-next{right:-22px}\n.rswho-nav[disabled]{opacity:.35;cursor:default}\n.rswho-dots{display:flex;justify-content:center;gap:8px;margin-top:14px}\n.rswho-dots button{width:8px;height:8px;border-radius:50%;border:0;padding:0;background:#e3d6c8;cursor:pointer}\n.rswho-dots button.on{background:#d98e5f;width:22px;border-radius:4px}\n.rswho-ship{font-family:\"Nunito Sans\",sans-serif;font-size:16px;color:#000;margin:18px 0 0}\n.rswho-ship span{color:#2e9e48;font-weight:700}\n@media (max-width:989px){.rswho-card{flex-basis:calc((100% - 24px)/2)}}\n@media (max-width:749px){.rswho-card{flex-basis:82%}.rswho-nav{display:none}.rswho-body h3{font-size:20px}.rswho-body p{font-size:16px}}\n</style>\n<script>\n(function(){var r=document.getElementById('rswho');if(!r)return;var t=r.querySelector('.rswho-track'),cs=[].slice.call(t.children),pv=r.querySelector('.rswho-prev'),nx=r.querySelector('.rswho-next'),dw=r.querySelector('.rswho-dots');\nfunction step(){return cs.length>1?cs[1].offsetLeft-cs[0].offsetLeft:t.clientWidth}\nfunction per(){return Math.max(1,Math.round(t.clientWidth/step()))}\nfunction pages(){return Math.max(1,cs.length-per()+1)}\nfunction idx(){return Math.round(t.scrollLeft/step())}\nfunction draw(){var n=pages();if(dw.children.length!==n){dw.innerHTML='';for(var i=0;i<n;i++){var b=document.createElement('button');b.type='button';(function(i){b.onclick=function(){t.scrollTo({left:i*step()})}})(i);dw.appendChild(b)}}\n var c=Math.min(idx(),n-1);[].forEach.call(dw.children,function(b,i){b.classList.toggle('on',i===c)});pv.disabled=c<=0;nx.disabled=c>=n-1}\npv.onclick=function(){t.scrollBy({left:-step()})};nx.onclick=function(){t.scrollBy({left:step()})};\nt.addEventListener('scroll',function(){clearTimeout(t._d);t._d=setTimeout(draw,60)},{passive:true});window.addEventListener('resize',draw);draw();})();\n</script>",
        "color_scheme": "",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
