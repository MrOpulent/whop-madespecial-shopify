        "custom_liquid_4UC37j": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Auto-select the visitor's own country (AU, NZ, IN, ...) once, on first arrival.\n  If the visitor later picks a country in the dropdown, we never override it.\n{%- endcomment -%}\n{%- unless request.design_mode -%}\n<script>\n(function () {\n  var KEY = 'msGeoCountryDone';\n  try {\n    if (localStorage.getItem(KEY)) return;\n  } catch (e) { return; }\n\n  document.addEventListener('click', function (e) {\n    if (e.target.closest('form[action*=\"/localization\"] a[data-value]')) {\n      try { localStorage.setItem(KEY, 'manual'); } catch (err) {}\n    }\n  });\n\n  fetch('/browsing_context_suggestions.json')\n    .then(function (r) { return r.json(); })\n    .then(function (data) {\n      var cc = data && data.detected_values && data.detected_values.country\n        ? data.detected_values.country.handle : null;\n      try { localStorage.setItem(KEY, cc || 'none'); } catch (e) {}\n      if (!cc || cc === '{{ localization.country.iso_code }}') return;\n\n      var form = document.getElementById('HeaderCountryForm')\n        || document.getElementById('HeaderCountryMobileForm')\n        || document.querySelector('form[action*=\"/localization\"]');\n      if (!form || !form.querySelector('a[data-value=\"' + cc + '\"]')) return;\n\n      var input = form.querySelector('input[name=\"country_code\"]');\n      if (!input) return;\n      input.value = cc;\n      form.querySelectorAll('input[name=\"return_to\"]').forEach(function (i) {\n        i.value = location.pathname + location.search;\n      });\n      form.submit();\n    })\n    .catch(function () {});\n})();\n</script>\n{%- endunless -%}"
          }
        },
        "custom_liquid_E7exYd": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<h1 class=\"blocky-title\" style=\"font-size:clamp(30px,3.2vw,42px);margin:0 0 8px;font-weight:400;line-height:1.12\">Margaret’s Rain Drum (13 inch - XXL)</h1><p style=\"margin:0 0 14px;color:#8B1E2D;font-weight:700;letter-spacing:.6px;text-transform:uppercase;font-size:15px\">\n    &#9679; Last Batch. Only 16 Left</p>\n<div style=\"display:flex;align-items:center;gap:14px;margin:4px 0\"><img\n        src=\"https://cdn.shopify.com/s/files/1/0793/6360/4662/files/margaret-avatar-v2.jpg?v=1792164370\" width=\"58\" height=\"58\" alt=\"Margaret Hayes\"\n        style=\"width:58px;height:58px;border-radius:50%;object-fit:cover;border:2px solid #4A6D7C;flex:0 0 58px\">\n    <p style=\"margin:0;font-style:italic;color:#1f3540;line-height:1.45\">\"This turns rain into music.\"<br><span\n            style=\"font-style:normal;color:#4A6D7C\">— Margaret Hayes, 64</span></p>\n</div>\n<style>\n    @media(max-width:749px) {\n        .kaching-bundles__bar-first-line {\n            flex-direction: column !important;\n            align-items: flex-start !important;\n            gap: 4px !important\n        }\n\n        .kaching-bundles__bar-label {\n            margin-left: 0 !important\n        }\n\n        .blocky-product-description,\n        .blocky-product-description p,\n        .blocky-product-collapsible,\n        .blocky-product-collapsible p,\n        .blocky-product-collapsible summary {\n            font-size: 16px !important;\n            line-height: 1.5 !important\n        }\n\n        [id*=scrolling_text_bar] * {\n            font-size: 14px !important\n        }\n\n        [id*=product_icons] p,\n        [id*=product_icons] [class*=description] {\n            font-size: 15px !important;\n            line-height: 1.5 !important\n        }\n    }\n\n    .blocky-product-submit,\n    .blocky-product-submit * {\n        font-size: 19px !important\n    }\n</style>\n<style>\n    #tidio-chat,\n    #tidio-chat-iframe {\n        display: none !important;\n        visibility: hidden !important;\n        pointer-events: none !important\n    }\n</style>\n<script>(function () { function h() { try { if (window.tidioChatApi) { window.tidioChatApi.hide(); } } catch (e) { } var el = document.getElementById('tidio-chat'); if (el) { el.style.setProperty('display', 'none', 'important'); } } document.addEventListener('tidioChat-ready', h); document.addEventListener('tidioChat-open', h); var n = 0; var t = setInterval(function () { h(); if (++n > 40) { clearInterval(t); } }, 500); })();</script>"
          }
