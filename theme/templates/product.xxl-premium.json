    "rs_compare": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- assign vs_o = all_products['steel-tongue-rain-drum'] -%}\n{%- assign vs_from = product.price | times: 0.583366 | round -%}\n{%- assign vs_op = vs_o.price -%}\n<section class=\"vs\" id=\"rs-compare\">\n <div class=\"vs-panel\">\n  <div class=\"vs-rain\" aria-hidden=\"true\"></div>\n  <div class=\"vs-head\"><p class=\"vs-eyebrow\">Which drum?</p><h2 class=\"vs-h\">The original, <em>or the 13-inch?</em></h2><p class=\"vs-sub\">Both sing in the rain. Only one is the gift they'll talk about all year.</p></div>\n  <div class=\"vs-grid\">\n   <article class=\"vs-card vs-orig\">\n    <div class=\"vs-top\">\n     <div class=\"vs-img vs-img--s\">{%- if vs_o.featured_image -%}<img src=\"{{ vs_o.featured_image | image_url: width: 300 }}\" alt=\"The original 4-inch drum\" width=\"150\" height=\"150\" loading=\"lazy\">{%- endif -%}</div>\n     <h3 class=\"vs-name\">The Original</h3><p class=\"vs-tag\">4 inches · 9 notes</p>\n    </div>\n    <ul class=\"vs-list\">\n     <li><span class=\"vs-l\">Size</span><span class=\"vs-v\">4 in</span></li><li><span class=\"vs-l\">Notes</span><span class=\"vs-v\">9</span></li><li><span class=\"vs-l\">Sound</span><span class=\"vs-v\">Bright and light</span></li><li><span class=\"vs-l\">Plays in the rain</span><span class=\"vs-v\"><span class=\"vs-ck\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></span></span></li><li><span class=\"vs-l\">Best as</span><span class=\"vs-v\">A stocking filler</span></li>\n    </ul>\n    <div class=\"vs-price\"><span class=\"vs-pl\">Price</span><span class=\"vs-pv\">{%- if vs_op -%}{{ vs_op | money }}{%- else -%}$49.99{%- endif -%}</span></div>\n   </article>\n   <div class=\"vs-badge\" aria-hidden=\"true\">VS</div>\n   <article class=\"vs-card vs-xl\">\n    <span class=\"vs-flag\">★ Most gifted</span>\n    <div class=\"vs-top\">\n     <div class=\"vs-img vs-img--l\">{%- if product.featured_image -%}<img src=\"{{ product.featured_image | image_url: width: 500 }}\" alt=\"The 13-inch XXL Premium rain drum in its gift box\" width=\"250\" height=\"250\" loading=\"lazy\">{%- endif -%}</div>\n     <h3 class=\"vs-name\">13-Inch XXL Premium</h3><p class=\"vs-tag\">13 inches · our biggest drum</p>\n    </div>\n    <ul class=\"vs-list\">\n     <li><span class=\"vs-l\">Size</span><span class=\"vs-v\"><strong>13 in <span class=\"vs-chip\">3× wider</span></strong></span></li><li><span class=\"vs-l\">Notes</span><span class=\"vs-v\"><strong>Numbered</strong></span></li><li><span class=\"vs-l\">Sound</span><span class=\"vs-v\"><strong>Deepest, fullest ring</strong></span></li><li><span class=\"vs-l\">Plays in the rain</span><span class=\"vs-v\"><span class=\"vs-ck\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></span></span></li><li><span class=\"vs-l\">Best as</span><span class=\"vs-v\"><strong>The main gift</strong></span></li>\n    </ul>\n    <div class=\"vs-price\"><span class=\"vs-pl\">From</span><span class=\"vs-pv\" data-vs-from>{{ vs_from | money }}<small> a drum</small></span></div>\n    <p class=\"vs-bonus\">🎁 + 7 free bonus pieces with every drum</p>\n    <a href=\"#\" class=\"vs-btn\" data-vs-buy>Customize Your Bundle <span aria-hidden=\"true\">→</span></a>\n   </article>\n  </div>\n  <p class=\"vs-note\">Free tracked shipping · 30-day money-back guarantee</p>\n </div>\n</section>\n<script>(function(){var el=document.querySelector('[data-vs-from]');if(!el)return;var tries=0;\nfunction num(t){var m=String(t).replace(/,/g,'').match(/(\\d+(?:\\.\\d+)?)/);return m?parseFloat(m[1]):null}\nfunction upd(){var best=null,txt=null;[].forEach.call(document.querySelectorAll('.kaching-bundles__bar-price'),function(p){var lab=p.querySelector('.kaching-bundles__bar-price__unit-label');if(!lab)return;var t=p.textContent.replace(lab.textContent,'').trim();var v=num(t);if(v!=null&&(best==null||v<best)){best=v;txt=t}});\n if(txt){el.firstChild.nodeValue=txt;return true}return false}\n(function loop(){if(upd()||++tries>40)return;setTimeout(loop,250)})();})();</script>\n<style>\n.vs{max-width:1240px;margin:0 auto;padding:0 20px;font-family:\"Nunito Sans\",sans-serif}\n.vs-panel{position:relative;overflow:hidden;border-radius:32px;padding:64px 48px 44px;background:radial-gradient(120% 80% at 80% 0%,#2c6a63 0%,rgba(44,106,99,0) 60%),radial-gradient(90% 70% at 0% 100%,#173d39 0%,rgba(23,61,57,0) 60%),linear-gradient(160deg,#1b4a45 0%,#10302c 100%);color:#f4ede3}\n.vs-rain{position:absolute;left:0;right:0;top:-120px;bottom:0;pointer-events:none;opacity:.55;background-image:radial-gradient(1px 9px at 10% 20%,rgba(255,255,255,.55),transparent),radial-gradient(1px 7px at 35% 65%,rgba(255,255,255,.4),transparent),radial-gradient(1px 10px at 62% 35%,rgba(255,255,255,.5),transparent),radial-gradient(1px 6px at 85% 80%,rgba(255,255,255,.35),transparent),radial-gradient(1px 8px at 50% 5%,rgba(255,255,255,.45),transparent);background-size:180px 120px;animation:vsRain 1.4s linear infinite}\n@keyframes vsRain{from{transform:translateY(0)}to{transform:translateY(120px)}}\n@media (prefers-reduced-motion:reduce){.vs-rain{animation:none}}\n.vs-head{position:relative;text-align:center;margin-bottom:44px}\n.vs-eyebrow{font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:#e3b97f;margin:0 0 10px;font-weight:700}\n.vs-h{font-family:Lora,serif;font-weight:400;font-size:clamp(32px,4.4vw,54px);line-height:1.08;margin:0;color:#fff}\n.vs-h em{font-style:italic;color:#e9c48e}\n.vs-sub{font-size:17px;color:rgba(244,237,227,.78);margin:14px auto 0;max-width:540px}\n.vs-grid{position:relative;display:grid;grid-template-columns:.9fr auto 1.1fr;gap:0 26px;align-items:center;max-width:980px;margin:0 auto}\n.vs-card{position:relative;border-radius:26px;padding:30px 28px 28px}\n.vs-orig{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(4px);color:rgba(244,237,227,.85)}\n.vs-xl{background:linear-gradient(180deg,#fffdf9 0%,#fbf3e8 100%);color:#1e1a16;box-shadow:0 0 0 2px #e3b97f,0 30px 60px -20px rgba(0,0,0,.55),0 0 80px -10px rgba(233,196,142,.35);transform:translateY(0);transition:transform .35s cubic-bezier(.2,.7,.2,1)}\n.vs-xl:hover{transform:translateY(-6px)}\n.vs-flag{position:absolute;top:-15px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#f0c98d,#d49a52);color:#3b2410;font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;padding:7px 16px;border-radius:999px;white-space:nowrap;box-shadow:0 10px 20px -10px rgba(0,0,0,.6)}\n.vs-top{text-align:center;margin-bottom:18px}\n.vs-img{margin:0 auto;border-radius:50%;overflow:hidden}\n.vs-img img{width:100%;height:100%;object-fit:cover;display:block}\n.vs-img--s{width:96px;height:96px;box-shadow:0 0 0 4px rgba(255,255,255,.12);opacity:.9}\n.vs-img--l{width:150px;height:150px;box-shadow:0 0 0 5px #fff,0 0 0 7px #e3b97f,0 18px 30px -12px rgba(0,0,0,.45)}\n.vs-name{font-family:Lora,serif;font-weight:400;font-size:24px;margin:16px 0 2px;color:inherit}\n.vs-xl .vs-name{font-size:28px;color:#13332f}\n.vs-tag{font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;margin:0;opacity:.75}\n.vs-list{list-style:none;margin:0;padding:0}\n.vs-list li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 2px;border-top:1px dashed rgba(255,255,255,.16);font-size:16px}\n.vs-xl .vs-list li{border-top-color:#eadfce}\n.vs-l{font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;opacity:.7}\n.vs-v{text-align:right}\n.vs-xl .vs-v strong{color:#13332f}\n.vs-chip{display:inline-block;margin-left:6px;font-size:11px;font-weight:800;color:#1f5652;background:#dcebe8;border-radius:999px;padding:3px 8px;vertical-align:middle}\n.vs-ck{display:inline-flex;width:24px;height:24px;border-radius:50%;align-items:center;justify-content:center;background:rgba(255,255,255,.12);color:#cfe7d8}\n.vs-xl .vs-ck{background:#2e9e48;color:#fff}\n.vs-price{display:flex;justify-content:space-between;align-items:baseline;margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,.18)}\n.vs-xl .vs-price{border-top-color:#e3d3bd}\n.vs-pl{font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;opacity:.7}\n.vs-pv{font-family:Lora,serif;font-size:28px}\n.vs-xl .vs-pv{font-size:36px;color:#13332f}\n.vs-pv small{font-family:\"Nunito Sans\",sans-serif;font-size:14px;opacity:.7}\n.vs-bonus{margin:12px 0 0;padding:10px 14px;border-radius:12px;background:#fdeee3;color:#9a3412;font-size:14.5px;font-weight:700;text-align:center}\n.vs-btn{display:flex;justify-content:center;align-items:center;gap:10px;margin-top:16px;background:linear-gradient(135deg,#34a853,#2e7d32);color:#fff!important;text-decoration:none;font-weight:800;font-size:17px;padding:16px 24px;border-radius:999px;box-shadow:0 14px 26px -12px rgba(46,125,50,.9);transition:transform .2s,box-shadow .2s}\n.vs-btn:hover{transform:translateY(-2px);box-shadow:0 18px 32px -12px rgba(46,125,50,1)}\n.vs-btn span{transition:transform .2s}.vs-btn:hover span{transform:translateX(4px)}\n.vs-badge{width:62px;height:62px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:Lora,serif;font-style:italic;font-size:22px;color:#3b2410;background:linear-gradient(135deg,#f0c98d,#d49a52);box-shadow:0 0 0 6px rgba(255,255,255,.08),0 12px 24px -10px rgba(0,0,0,.6);position:relative;z-index:2}\n.vs-note{position:relative;text-align:center;font-size:14px;color:rgba(244,237,227,.7);margin:30px 0 0}\n@media (max-width:749px){.vs{padding:0 12px}.vs-panel{padding:44px 16px 30px;border-radius:24px}.vs-grid{grid-template-columns:1fr;gap:0}.vs-xl{order:-1}.vs-badge{width:50px;height:50px;font-size:18px;margin:-12px auto}.vs-card{padding:28px 20px 22px}.vs-img--l{width:120px;height:120px}.vs-xl .vs-pv{font-size:30px}.vs-sub{font-size:15px}.vs-head{margin-bottom:36px}}\n</style>\n<script>(function(){var b=document.querySelector('[data-vs-buy]');if(!b)return;b.addEventListener('click',function(e){e.preventDefault();var t=document.querySelector('blocky-featured-product kaching-bundles-block')||document.querySelector('blocky-featured-product');if(t)t.scrollIntoView({behavior:'smooth',block:'center'})})})();</script>",
